{
  // Mirrors template/.markdownlint-cli2.jsonc so the template repo lints its
  // own docs the same way it configures generated projects. MD013 (line
  // length) is disabled: prose docs (CLAUDE.md, JOURNAL.md, ADRs) wrap freely.
  "config": {
    "default": true,
    "MD013": false,
  },
  // `!CHANGELOG.md` mirrors template/.markdownlint-cli2.jsonc (PR #90): the
  // changelog is release-please-generated (linguist-generated) and its blank-line
  // layout is regenerated every release, so hand-linting it is futile churn.
  "globs": ["**/*.md", "**/*.markdown", "!CHANGELOG.md"],
  // `skills/` holds vendored Claude Code plugin skill docs (SKILL.md) that
  // mirror an externally-maintained skill; the repo does not restyle them
  // (same rationale as the `skills/` exclusion in _typos.toml).
  "ignores": ["skills/**"],
  "gitignore": true,
}
