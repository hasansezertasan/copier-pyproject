{
  "languages": {
    "Python": {
      "language_servers": ["ruff", "..."],
      "formatter": {
        "language_server": { "name": "ruff" }
      },
      "format_on_save": "on"
    }
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          "line-length": 88
        }
      }
    }
  },
  "file_scan_exclusions": [
    "**/.tox",
    "**/.venv",
    "**/_build",
    "**/*.egg-info"
  ]
}
