{%- if include_worker %}

# -- Worker AsyncAPI schema --------------------------------------------------
# Emit the FastStream worker's AsyncAPI spec straight from the live ``app``
# object so the "Worker message interface" page can ``literalinclude`` a
# machine-readable, always-in-sync description of the request/response channels,
# payload schemas, and the {{worker_broker}} binding. The spec is derived from
# the source of truth (the ``description=`` strings and Pydantic payload models
# already on the subscriber/publisher), regenerated on every docs build, and is
# not committed (``docs/_generated/`` is gitignored). ``docs-build`` runs Sphinx
# under ``-W``, so a broken app import or a failed generation fails the build.
import subprocess  # noqa: E402, S404
import sys  # noqa: E402
from pathlib import Path  # noqa: E402

_asyncapi_dir = Path(__file__).parent / "_generated"
_asyncapi_dir.mkdir(exist_ok=True)
subprocess.run(  # noqa: S603
    [
        sys.executable,
        "-m",
        "faststream",
        "docs",
        "gen",
        "--yaml",
        "{{github_repo_name}}.worker.app:app",
        "--out",
        str(_asyncapi_dir / "asyncapi.yaml"),
    ],
    check=True,
)
{%- endif %}
