"""Tests for the package's runnable entrypoint (``python -m {{github_repo_name}}``)."""

import importlib
{%- if console_root_needs_typer %}
import sys
{%- endif %}
{%- if console_root_needs_typer or not has_component %}

import pytest
{%- endif %}


def test_main_is_callable() -> None:
    """The package exposes a callable ``main()`` entrypoint.

    Every standalone-executable build (launcher / freezer / compiler — see
    ADR-007) targets ``{{github_repo_name}}.__main__:main``, so this pins the
    contract that the symbol exists and is callable for whichever component is
    enabled, and that the active branch's component import actually resolves.
    The module is imported (not executed as ``__main__``), so a runnable
    component's blocking ``main()`` (server loop, mainloop, ...) is never invoked.
    """
    main_module = importlib.import_module("{{github_repo_name}}.__main__")

    assert callable(main_module.main)
{%- if console_root_needs_typer %}
    # The Typer console root is resolved through ``_load_console_root`` (so a
    # missing ``typer`` stays actionable rather than a bare traceback); calling
    # it here performs the same import ``main()`` would and pins the wiring.
    assert callable(vars(main_module)["_load_console_root"]())
{%- elif include_console_root %}
    # The console root (CLI or shared launcher) wires ``app`` into __main__;
    # assert it resolved.
    assert hasattr(main_module, "app")
{%- elif include_gui or include_tui or include_web or include_mcp or include_worker %}
    # Every non-CLI component is dispatched through an imported ``_entry``
    # callable; assert the wiring imported it (guards the if/elif precedence).
    # Read from the module namespace to avoid a private-member-access lint.
    assert callable(vars(main_module)["_entry"])
{%- endif %}
{%- if not has_component %}


def test_main_exits_loudly_when_no_component() -> None:
    """With no runnable component, ``main()`` exits non-zero instead of no-op-ing.

    This combination (a standalone build with nothing to run) is degenerate but
    allowed; ``main()`` must fail loudly so the produced binary does not look
    like a silently broken executable. Safe to invoke here because there is no
    blocking component behind it.
    """
    main_module = importlib.import_module("{{github_repo_name}}.__main__")

    with pytest.raises(SystemExit):
        main_module.main()
{%- endif %}
{%- if console_root_needs_typer %}


def test_console_root_reports_missing_launcher_dependency(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    """A missing ``typer`` is reported actionably, not as a bare traceback.

    Given:
        - An environment out of sync with the installed package, so the console
          root's own ``typer`` dependency cannot be imported -- what a ``copier
          update`` that adds the shared launcher leaves behind until ``uv sync``.
    When:
        - ``__main__`` loads the console root, as bare ``{{github_repo_name}}`` does.
    Then:
        - It exits 1 with a message naming ``typer`` and ``uv sync``, and no
          traceback.
    """
    main_module = importlib.import_module("{{github_repo_name}}.__main__")
    monkeypatch.setitem(sys.modules, "typer", None)
    monkeypatch.delitem(sys.modules, "{{github_repo_name}}.cli", raising=False)
    monkeypatch.delitem(sys.modules, "{{github_repo_name}}.cli.app", raising=False)

    with pytest.raises(SystemExit) as excinfo:
        _ = vars(main_module)["_load_console_root"]()

    assert excinfo.value.code == 1
    err = capsys.readouterr().err
    assert "typer" in err
    assert "uv sync" in err
    assert "Traceback" not in err


def test_console_root_preserves_unrelated_import_errors(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    """A missing module other than ``typer`` keeps its own diagnostics.

    Given:
        - Loading the console root fails for an unrelated reason (here the
          ``cli`` package itself), which is an application defect rather than an
          out-of-sync environment.
    When:
        - ``__main__`` loads the console root.
    Then:
        - The original ``ModuleNotFoundError`` propagates and is never relabelled
          as something ``uv sync`` would fix.
    """
    main_module = importlib.import_module("{{github_repo_name}}.__main__")
    monkeypatch.setitem(sys.modules, "{{github_repo_name}}.cli", None)

    with pytest.raises(ModuleNotFoundError, match=r"{{github_repo_name}}\.cli"):
        _ = vars(main_module)["_load_console_root"]()

    assert "uv sync" not in capsys.readouterr().err
{%- endif %}
