class _DependencyMissingFinder:
    """Fail one module's import the way an out-of-sync environment does.

    Driven through ``sys.meta_path`` rather than by patching ``sys.modules`` so
    the scenario reproduces identically whether or not the runner actually has
    the module installed -- which matters most for ``_tkinter``, reached only
    through ``tkinter``'s own unguarded import of it.
    """

    def __init__(self, trigger: str, missing: str) -> None:
        self._trigger = trigger
        self._missing = missing

    def find_spec(
        self,
        fullname: str,
        path: Sequence[str] | None,
        target: ModuleType | None = None,
    ) -> ModuleSpec | None:
        """Fail the triggering import, naming the module that is missing.

        Raises:
            ModuleNotFoundError: Naming ``missing`` when ``trigger`` is imported.
        """
        del path, target
        if fullname == self._trigger:
            message = f"No module named {self._missing!r}"
            raise ModuleNotFoundError(message, name=self._missing)
        return None


@pytest.mark.parametrize("dependency", _SOLE_DEPENDENCIES)
def test_sole_component_reports_missing_dependency(
    dependency: str, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    """A missing dependency is reported actionably, not as a bare traceback.

    This project enables exactly one runnable component, so there is no console
    root to route through and ``__main__`` binds
    ``{{github_repo_name}}.{{sole_component}}.app`` directly -- the ADR-007
    standalone-executable entrypoint, whose user has no CLI to fall back on.
    Every module parametrized here is reached by that import: the component's
    own dependencies, plus the settings stack ``core.logging_setup`` ->
    ``core.config`` pulls in at module scope.

    Given:
        - An environment out of sync with the installed package, so one of those
          modules cannot be imported -- what a ``copier update`` that enabled
          this component leaves behind until ``uv sync``.
    When:
        - ``__main__`` loads the component, as bare ``{{github_repo_name}}`` and
          ``python -m {{github_repo_name}}`` both do.
    Then:
        - It exits 1 with a message naming the component, the module, and the
          fix that actually applies, and no traceback.
    """
    main_module = importlib.import_module("{{github_repo_name}}.__main__")
{%- if sole_component == "gui" %}
    # ``_tkinter`` is never imported under its own name: ``tkinter/__init__.py``
    # imports it unguarded, which is how a Tk-less interpreter fails.
    trigger = "tkinter" if dependency == "_tkinter" else dependency
{%- else %}
    trigger = dependency
{%- endif %}
    finder = _DependencyMissingFinder(trigger, dependency)
    # The stub intercepts only its own target, so an unrelated import still
    # resolves normally -- and the pass-through arm stays exercised.
    assert finder.find_spec("json", None) is None
    monkeypatch.setattr(sys, "meta_path", [finder, *sys.meta_path])
    for cached in (trigger, dependency):
        monkeypatch.delitem(sys.modules, cached, raising=False)
    # Drop the package's own modules so the guarded import chain runs again.
    prefix = "{{github_repo_name}}."
    for cached in [name for name in sys.modules if name.startswith(prefix)]:
        monkeypatch.delitem(sys.modules, cached, raising=False)

    with pytest.raises(SystemExit) as excinfo:
        _ = vars(main_module)["_load_component"]()

    assert excinfo.value.code == 1
    err = capsys.readouterr().err
    assert "{{ component_label[sole_component] }}" in err
    assert dependency in err
    assert "Traceback" not in err
{%- if sole_component == "gui" %}
    # Tk is a system package, so ``uv sync`` is the wrong advice for it.
    assert ("python3-tk" if dependency in _TK_MODULES else "uv sync") in err
{%- else %}
    assert "uv sync" in err
{%- endif %}


def test_sole_component_preserves_unrelated_import_errors(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    """A missing module that is not a component dependency keeps its diagnostics.

    Given:
        - Loading the component fails for an unrelated reason (here its own
          ``app`` module), which is an application defect rather than an
          out-of-sync environment.
    When:
        - ``__main__`` loads the component.
    Then:
        - The original ``ModuleNotFoundError`` propagates and is never relabelled
          as something ``uv sync`` would fix.
    """
    main_module = importlib.import_module("{{github_repo_name}}.__main__")
    component_module = "{{github_repo_name}}.{{sole_component}}.app"
    monkeypatch.setitem(sys.modules, component_module, None)

    with pytest.raises(ModuleNotFoundError, match=re.escape(component_module)):
        _ = vars(main_module)["_load_component"]()

    assert "uv sync" not in capsys.readouterr().err


