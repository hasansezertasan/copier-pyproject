    # here performs the same import ``main()`` would and pins the wiring.
    assert callable(vars(main_module)["_load_console_root"]())
{%- elif include_console_root %}
    # The console root (CLI or shared launcher) wires ``app`` into __main__;
    # assert it resolved.
    assert hasattr(main_module, "app")
{#- No console root, so ``sole_component`` names the single non-CLI component. -#}
{%- elif sole_component %}
    # The component is resolved through ``_load_component`` (so a missing
    # dependency stays actionable rather than a bare traceback at the ADR-007
    # standalone-executable entrypoint); calling it here performs the same import
    # ``main()`` would and pins the if/elif precedence.
    assert callable(vars(main_module)["_load_component"]())
