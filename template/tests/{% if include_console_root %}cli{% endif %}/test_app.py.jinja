def test_help_lists_subcommands(capsys: pytest.CaptureFixture[str]) -> None:
    """``--help`` renders the root usage and exits 0.

    Given:
        - The {{github_repo_name}} argparse root.
    When:
        - ``--help`` is requested.
    Then:
        - The command exits 0; each enabled component subcommand is advertised.
    """
    with pytest.raises(SystemExit) as excinfo:
        app(["--help"])
    assert excinfo.value.code == 0
    out = capsys.readouterr().out
    assert "usage" in out.lower()
{%- for name in subcommands %}
    assert "{{ name }}" in out
{%- endfor %}


def test_no_command_prints_help(capsys: pytest.CaptureFixture[str]) -> None:
    """With no subcommand the parser prints help instead of exiting silently."""
    app([])
    assert "usage" in capsys.readouterr().out.lower()


def test_version(capsys: pytest.CaptureFixture[str]) -> None:
    """The `version` command prints a non-empty version string."""
    app(["version"])
    assert capsys.readouterr().out.strip()


def test_info(capsys: pytest.CaptureFixture[str]) -> None:
    """The `info` command prints application, Python, and platform lines."""
    app(["info"])
    out = capsys.readouterr().out
    assert "Application Version:" in out
    assert "Python Version:" in out
    assert "Platform:" in out


@pytest.mark.parametrize("command", ["version", "info"])
def test_command_fails_loudly_when_metadata_missing(
    monkeypatch: pytest.MonkeyPatch, command: str
) -> None:
    """Commands exit 1 when package metadata is missing.

    Given:
        - Package metadata cannot be resolved (broken/partial install).
    When:
        - The `version` or `info` command is invoked.
    Then:
        - The command exits with code 1 instead of dumping a traceback or
          silently printing nothing.
    """
    monkeypatch.setattr(cli_app, "Distribution", _MissingDistribution)

    with pytest.raises(SystemExit) as excinfo:
        app([command])

    assert excinfo.value.code == 1
{%- if need_import_guard %}


def test_missing_component_dependency_is_actionable(
    capsys: pytest.CaptureFixture[str],
) -> None:
    """A missing component dependency exits 1 with a message naming the fix.

    Given:
        - A launcher subcommand whose lazy import raises ``ModuleNotFoundError``
          (an environment out of sync with the installed package).
    When:
        - The import is performed inside the component-dependency guard.
    Then:
        - The command exits 1 and stderr names the component, the missing module,
          and ``uv sync`` -- instead of dumping a bare ``ModuleNotFoundError``.

    Raises:
        ModuleNotFoundError: Simulating the missing dependency; the guard converts
            it into the actionable exit.
    """
    with (
        pytest.raises(SystemExit) as excinfo,
        cli_app._component_dependencies("web", "uvicorn"),  # noqa: SLF001
    ):
        raise ModuleNotFoundError(_MISSING_MODULE_MESSAGE, name="uvicorn")

    assert excinfo.value.code == 1
    err = capsys.readouterr().err
    assert "web" in err
    assert "uvicorn" in err
    assert "uv sync" in err
{%- endif %}
{%- if include_tui %}


def test_tui_launcher_reports_missing_deferred_dependency(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    """The TUI launcher translates a missing lazy ``textual`` import."""
    monkeypatch.setitem(sys.modules, "textual", None)

    with pytest.raises(SystemExit) as excinfo:
        app(["interactive"])

    assert excinfo.value.code == 1
    err = capsys.readouterr().err
    assert "TUI" in err
    assert "textual" in err
    assert "uv sync" in err
    assert "Traceback" not in err
{%- endif %}
