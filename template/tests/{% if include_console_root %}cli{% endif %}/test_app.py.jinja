    monkeypatch.setattr(sys, "meta_path", [finder, *sys.meta_path])
    monkeypatch.delitem(sys.modules, "{{github_repo_name}}.web.app", raising=False)

    result: Result = runner.invoke(app, [{% if primary_component != "web" %}"web"{% endif %}])

    assert isinstance(result.exception, ModuleNotFoundError)
    assert result.exception.name == "user_plugin"
    assert "uv sync" not in result.output


