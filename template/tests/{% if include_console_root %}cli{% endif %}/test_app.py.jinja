def _homebrew_tk_formula() -> str:
    """Return the Homebrew Tk formula this interpreter's version needs.

    Returns:
        str: e.g. ``"python-tk@3.12"``.
    """
    return f"python-tk@{sys.version_info.major}.{sys.version_info.minor}"


_TK_EXTENSION_MESSAGE = "No module named '_tkinter'"


class _TkExtensionMissingFinder:
    """Simulate a Python built without tk-dev.

    The pure-Python ``tkinter`` package ships, so the import proceeds far enough
    to run its unguarded ``import _tkinter`` and fail naming the C extension.
    Reproduced with a finder rather than by patching ``sys.modules`` so the test
    is identical on runners that have no ``tkinter`` package at all.
    """

    @staticmethod
    def find_spec(
        fullname: str, path: Sequence[str] | None, target: ModuleType | None = None
    ) -> ModuleSpec | None:
        """Fail a ``tkinter`` import the way a missing C extension does.

        Raises:
            ModuleNotFoundError: Naming ``_tkinter`` when ``tkinter`` is imported.
        """
        del path, target
        if fullname == "tkinter":
            raise ModuleNotFoundError(_TK_EXTENSION_MESSAGE, name="_tkinter")
        return None


def test_gui_launcher_reports_missing_tkinter(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    """A Tk-less interpreter gets a system-level hint, not ``uv sync``.

    Given:
        - An interpreter built without Tk, which ``gui.app`` only discovers when
          it draws the window -- after the launcher's guard would have closed.
    When:
        - The public GUI launcher starts the GUI component.
    Then:
        - The command exits 1 naming ``tkinter`` and a platform Tk package;
          ``uv sync`` is *not* suggested, because Tk is not a distribution.
    """
    monkeypatch.setitem(sys.modules, "tkinter", None)

    with pytest.raises(SystemExit) as excinfo:
        app(["gui"])

    assert excinfo.value.code == 1
    err = capsys.readouterr().err
    assert "GUI" in err
    assert "tkinter" in err
    assert "python3-tk" in err
    # Homebrew's bare ``python-tk`` aliases the newest Python's formula, so the
    # hint must name this interpreter's version.
    assert _homebrew_tk_formula() in err
    assert "uv sync" not in err
    assert "Traceback" not in err


def test_gui_launcher_reports_missing_tk_extension(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    """A build with the ``tkinter`` package but no ``_tkinter`` is also covered.

    Given:
        - An interpreter built without tk-dev: the pure-Python ``tkinter``
          package still ships, but the C extension its ``__init__`` imports
          unguarded does not -- so the failure names ``_tkinter``, not
          ``tkinter``.
    When:
        - The public GUI launcher starts the GUI component.
    Then:
        - The same actionable Tk message is shown, not a bare traceback.
    """
    finder = _TkExtensionMissingFinder()
    monkeypatch.setattr(sys, "meta_path", [finder, *sys.meta_path])
    monkeypatch.delitem(sys.modules, "tkinter", raising=False)

    with pytest.raises(SystemExit) as excinfo:
        app(["gui"])

    assert excinfo.value.code == 1
    err = capsys.readouterr().err
    assert "GUI" in err
    assert "_tkinter" in err
    assert "python3-tk" in err
    assert "Traceback" not in err
