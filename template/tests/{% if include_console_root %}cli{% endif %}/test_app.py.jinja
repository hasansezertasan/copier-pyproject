_RUNTIME_MISSING_MODULE = "No module named 'user_plugin'"


class _ApplicationImportFailureFinder:
    """Simulate an unrelated import bug while loading the web application."""

    @staticmethod
    def find_spec(
        fullname: str, path: Sequence[str] | None, target: ModuleType | None = None
    ) -> ModuleSpec | None:
        """Raise the nested application error when the web module is imported.

        Raises:
            ModuleNotFoundError: When the generated web module is requested.
        """
        del path, target
        if fullname == "{{github_repo_name}}.web.app":
            raise ModuleNotFoundError(_RUNTIME_MISSING_MODULE, name="user_plugin")
        return None


def _raise_runtime_import_error(*_args: object, **_kwargs: object) -> NoReturn:
    """Simulate an application import bug after the web dependency preflight.

    Raises:
        ModuleNotFoundError: Always, standing in for an application import bug.
    """
    raise ModuleNotFoundError(_RUNTIME_MISSING_MODULE, name="user_plugin")


def test_web_launcher_reports_missing_deferred_dependency(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    """The web launcher translates a missing lazy ``uvicorn`` import.

    Given:
        - The generated environment cannot import ``uvicorn``.
    When:
        - The public web launcher starts the web component.
    Then:
        - The command exits 1 and reports how to synchronize the environment,
          without exposing the underlying ``ModuleNotFoundError`` traceback.
    """
    monkeypatch.setitem(sys.modules, "uvicorn", None)

    with pytest.raises(SystemExit) as excinfo:
        app(["web"])

    assert excinfo.value.code == 1
    err = capsys.readouterr().err
    assert "web" in err
    assert "uvicorn" in err
    assert "uv sync" in err
    assert "Traceback" not in err


def test_web_launcher_preserves_import_time_application_errors(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    """An unrelated failure while importing the app keeps its diagnostics."""
    finder = _ApplicationImportFailureFinder()
    monkeypatch.setattr(sys, "meta_path", [finder, *sys.meta_path])
    monkeypatch.delitem(sys.modules, "{{github_repo_name}}.web.app", raising=False)

    with pytest.raises(ModuleNotFoundError, match="user_plugin"):
        app(["web"])

    assert "uv sync" not in capsys.readouterr().err


def test_web_launcher_preserves_runtime_import_errors(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    """An import failure during server execution is not called a stale venv."""
    monkeypatch.setattr(uvicorn, "run", _raise_runtime_import_error)

    with pytest.raises(ModuleNotFoundError, match="user_plugin"):
        app(["web"])

    assert "uv sync" not in capsys.readouterr().err
