"""Integration tests for the worker against a real {{worker_broker}} (ADR-008).

By default these start a real {{worker_broker}} in a container via
testcontainers, so they are marked ``integration`` and excluded from the default
suite. Run them explicitly with ``pytest -m integration`` (Docker required).

The ``broker_url`` fixture reads a single seam: if ``{{ worker_broker_spec.env }}``
is already set, the tests connect to that broker directly and skip the
testcontainer. That lets CI point them at a runner-provided broker (a GitHub
Actions ``services:`` container, started and health-gated before the job) while
a local ``pytest -m integration`` still spins up its own container with no manual
setup (issue #169).
"""

from __future__ import annotations

import asyncio
import os
from typing import TYPE_CHECKING

import pytest
{%- if worker_broker == "kafka" %}
from testcontainers.community.kafka import KafkaContainer
{%- elif worker_broker == "nats" %}
from testcontainers.community.nats import NatsContainer
{%- elif worker_broker == "rabbitmq" %}
from testcontainers.community.rabbitmq import RabbitMqContainer
{%- elif worker_broker == "redis" %}
from testcontainers.community.redis import RedisContainer
{%- endif %}

from {{github_repo_name}}.worker.app import (
    REQUESTS_DESTINATION,
    RESPONSES_DESTINATION,
    VersionRequest,
    build_broker,
)

if TYPE_CHECKING:
    from collections.abc import Iterator

pytestmark = pytest.mark.integration

# Bound for connecting to the container-started broker, separate from the poll
# window below, so a connect hang fails with a stage-specific TimeoutError
# instead of eating the whole test timeout.
_START_TIMEOUT_SECONDS = 120
# How long to wait for the round-trip response before failing.
{%- if worker_broker == "kafka" %}
# Kafka gets a larger window: consumer-group join and topic auto-creation on a
# cold runner can take well over the ~10s that suffices for the other brokers.
_RESPONSE_POLLS = 150
{%- else %}
_RESPONSE_POLLS = 50
{%- endif %}
_POLL_INTERVAL_SECONDS = 0.2


@pytest.fixture
def broker_url() -> Iterator[str]:
    """Yield a live {{worker_broker}} URL for the round-trip test.

    When ``{{ worker_broker_spec.env }}`` is set the tests connect to that broker
    directly (CI ``services:`` path — the runner started and health-gated it
    before the job); otherwise a throwaway testcontainer is started for the
    duration of the test (the self-contained local path). See ADR-008 / issue
    #169.

    Yields:
        str: A connection URL for a live {{worker_broker}} broker.
    """
    env_url = os.getenv("{{ worker_broker_spec.env }}")
    if env_url:
        yield env_url
        return
{%- if worker_broker == "kafka" %}
    with KafkaContainer() as container:
        yield container.get_bootstrap_server()
{%- elif worker_broker == "nats" %}
    with NatsContainer() as container:
        host = container.get_container_host_ip()
        port = container.get_exposed_port(4222)
        yield f"nats://{host}:{port}"
{%- elif worker_broker == "rabbitmq" %}
    with RabbitMqContainer() as container:
        host = container.get_container_host_ip()
        port = container.get_exposed_port(5672)
        yield f"amqp://guest:guest@{host}:{port}/"
{%- elif worker_broker == "redis" %}
    with RedisContainer() as container:
        host = container.get_container_host_ip()
        port = container.get_exposed_port(6379)
        yield f"redis://{host}:{port}"
{%- endif %}


async def test_worker_roundtrip_against_real_broker(broker_url: str) -> None:
    """Consume a request and publish a response over a real broker.

    Exercises the actual driver and serialization that the in-memory unit test
    stubs out: a real {{worker_broker}} is started, the worker's broker is pointed
    at it, a request is published, and we assert the worker's response arrives on
    a collector subscriber.
    """
    worker_broker = build_broker(broker_url)
    responses: list[dict[str, object]] = []

    @worker_broker.subscriber(RESPONSES_DESTINATION)
    async def collect(msg: dict[str, object]) -> None:  # noqa: RUF029
        """Capture published version responses."""
        responses.append(msg)

    await asyncio.wait_for(worker_broker.start(), timeout=_START_TIMEOUT_SECONDS)
    try:
        # (Re)publish inside the poll loop rather than once up front: the
        # subscription is at-most-once from a cold consumer's perspective
        # (kafka resolves offsets to "latest", redis pub/sub and core NATS
        # do not replay), so a single message published before the consumer
        # is fully live would be dropped and no amount of waiting would
        # recover it. Re-sending the same request_id is idempotent here.
        for _ in range(_RESPONSE_POLLS):
            if responses:
                break
            await worker_broker.publish(
                VersionRequest(request_id="integration-001"), REQUESTS_DESTINATION
            )
            await asyncio.sleep(_POLL_INTERVAL_SECONDS)
    finally:
        await worker_broker.stop()

    # On failure, the root cause (handler exception, decode error, connection
    # drop) is in the captured FastStream log output pytest prints below.
    assert responses, "no version response received from the worker"
    first = responses[0]
    assert first["request_id"] == "integration-001"
    # The real serialization path is the point of this test (ADR-008): assert
    # the full payload shape, not just the correlation id.
    assert "version" in first
    assert "python_version" in first
    assert "platform" in first
