---
PARALLEL: true
DEFAULT_BRANCH: main
SHOW_ELAPSED_TIME: true
CLEAR_REPORT_FOLDER: true
OUTPUT_DETAIL: detailed
REPORT_OUTPUT_FOLDER: megalinter-reports
# CHANGELOG.md is generated and owned by release-please (double blank lines
# between sections, commit-hash links, etc.); exclude it from all linters so
# release PRs don't fail on machine-generated content.
FILTER_REGEX_EXCLUDE: (^|/)CHANGELOG\.md$
# MegaLinter is an OPTIONAL extra quality layer (include_megalinter). tox/prek are
# the canonical, blocking style runners, so this config uses no auto-fixes and
# enables ONLY linters prek/tox do not already cover -- it never duplicates them:
#   * actionlint / yamllint / markdownlint / editorconfig-checker -> prek
#   * cspell -> NOT enabled; typos (prek) is the single spell-checker
#   * Python (ruff + type-checkers + vulture) -> tox `style`
#   * secrets / vuln / SAST -> check-security.yml (gitleaks, pip-audit, trivy),
#     plus CodeQL and Scorecard
# See ADR-013.
APPLY_FIXES: none
# Report-only: never fail the job on findings. This layer is non-blocking at the
# exit-code level (tox/prek are the canonical gates); findings are delivered via
# the SARIF -> Security-tab upload and the reports artifact, mirroring zizmor.yml.
# Gate on the code-scanning results via branch protection if you want it to block.
DISABLE_ERRORS: true
GITHUB_COMMENT_REPORTER: false
GITHUB_STATUS_REPORTER: false
FILEIO_REPORTER: false
JSON_REPORTER: true
JSON_REPORTER_OUTPUT_DETAIL: simple
MARKDOWN_SUMMARY_REPORTER: true
REPORTERS_MARKDOWN_TYPE: simple
SARIF_REPORTER: true
ENABLE_LINTERS:
  # Standalone shell scripts (actionlint already shellchecks workflow `run:`
  # blocks; this covers scripts a project adds later). Keeps .shellcheckrc.
  - BASH_SHELLCHECK
{%- if include_web %}
  # The generated Dockerfile (only rendered when include_web) -- otherwise
  # nothing lints it.
  - DOCKERFILE_HADOLINT
{%- endif %}
  # Syntax-check the JSON/JSONC config files (only indent-checked otherwise).
  - JSON_JSONLINT
  # Copy-paste / clone detection -- a capability neither prek nor tox provides.
  - COPYPASTE_JSCPD
EXCLUDED_DIRECTORIES:
  - .git
  - .mypy_cache
  - .nox
  - .tox
  - .venv
  - build
  - dist
  - docs/_build
  - htmlcov
  - megalinter-reports
  - node_modules
BASH_SHELLCHECK_CONFIG_FILE: .github/linters/.shellcheckrc
# devcontainer.json and .vscode/*.json are JSON-with-comments (JSONC) by
# convention; the strict jsonlint parser rejects comments, so skip them.
JSON_JSONLINT_FILTER_REGEX_EXCLUDE: (^|/)\.vscode/|(^|/)devcontainer\.json$
