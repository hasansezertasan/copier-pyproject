{% raw %}min_version = "2024.9.5"

[env]
PROJECT_NAME = "{{ config_root | basename }}"
_.python.venv = { path = ".venv", create = true }

[tools]
python = "{{ get_env(name='PYTHON_VERSION', default='3.10') }}"
# ghalint (GitHub Actions workflow security-policy linter) is delivered via mise
# because it ships no PyPI wrapper or pre-commit hook. The aqua backend is named
# explicitly so resolution does not depend on the mise registry short name. The
# prek `ghalint` hook and the CI `hooks` job invoke this binary.
"aqua:suzuki-shunsuke/ghalint" = "1.5.6"
# cobo (copy boilerplates) manages the .gitignore fenced block from the
# github/gitignore templates recorded in cobo.lock. Delivered via mise's pipx
# backend (Renovate-tracked) and invoked as `mise exec -- cobo` by the
# gitignore-check task and the gitignore-drift.yml workflow. 0.4.0+ ships the
# `--eol` policy the block was sealed with.
"pipx:cobo" = "0.4.0"
{%- endraw %}
{%- if include_all_contributors %}
# all-contributors is a JS CLI delivered via mise's npm backend, so its version
# is pinned here (Renovate-tracked) and invoked as `mise exec -- all-contributors`
# by the all-contributors.yml workflow — mirroring ghalint above. mise installs it
# without node, but running it needs node on PATH (present on CI runners).
"npm:all-contributors-cli" = "6.26.1"
{%- endif %}
{% raw %}
[tasks.install]
description = "Install dependencies"
alias = "i"
run = "uv sync"

[tasks.test]
description = "Run tests"
alias = "t"
run = "uv run --locked tox run"

[tasks.style]
description = "Run style checks"
alias = "s"
run = "uv run --locked tox run -e style"

[tasks.lint]
description = "Lint the code with ruff"
alias = "l"
run = "uv run --locked ruff check"

[tasks.format]
description = "Format the code with ruff"
alias = "f"
run = "uv run --locked ruff format"
{%- endraw %}
{%- if include_docs %}

[tasks.docs-build]
description = "Build documentation"
run = "uv run --locked tox run -e docs-build"

[tasks.docs-serve]
description = "Serve documentation locally"
run = "uv run --locked tox run -e docs-server"

[tasks.docs-doctest]
description = "Run documentation doctests"
run = "uv run --locked tox run -e docs-doctest"
{%- endif %}
{% raw %}

[tasks.prek]
description = "Run prek hooks"
alias = "pc"
run = "uv run --locked tox run -e prek"

[tasks.gitignore-check]
description = "Check .gitignore for drift from the github/gitignore templates"
run = "mise exec -- cobo update && mise exec -- cobo check --strict"

[tasks.build]
description = "Build the package"
alias = "b"
run = "uv build"

[tasks.clean]
description = "Clean build artifacts"
run = "rm -rf dist/ build/ *.egg-info/ .tox/ .pytest_cache/ .mypy_cache/ .ruff_cache/"

[tasks.info]
description = "Print project information"
run = '''
echo "Project: $PROJECT_NAME"
echo "Python: $(python --version)"
echo "Virtual Environment: $VIRTUAL_ENV"
'''
{%- endraw %}
{%- if include_launcher %}

[tasks.package]
description = "Build a uv-bootstrap launcher executable with PyCrucible"
alias = "pkg"
run = "uv run --locked --group tool pycrucible -e . -o ./dist/{{github_repo_name}}"
{%- endif %}
{%- if include_freezer %}

[tasks.freeze]
description = "Build a self-contained offline executable with PyInstaller"
run = "uv run --locked --group tool pyinstaller {{github_repo_name}}.spec --clean --noconfirm"
{%- endif %}
{%- if include_compiler %}

[tasks.compile]
description = "Build a compiled native executable with Nuitka"
run = "uv run --locked --group tool python -m nuitka --onefile --assume-yes-for-downloads --output-dir=dist src/{{github_repo_name}}/__main__.py"
{%- endif %}
{%- if include_worker %}

[tasks.worker-probe]
description = "Send a sample request to the running worker and print the response"
run = "uv run python scripts/worker_probe.py"
{%- endif %}
