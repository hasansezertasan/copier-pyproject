{%- set cli_commands = ["version", "info"] -%}
{%- if include_web %}{% set _ = cli_commands.append("run") %}{% set _ = cli_commands.append("dev") %}{% endif -%}
{%- if include_tui and primary_component != 'tui' %}{% set _ = cli_commands.append("interactive") %}{% endif -%}
{%- if include_gui and primary_component != 'gui' %}{% set _ = cli_commands.append("gui") %}{% endif -%}
{%- if include_web and primary_component != 'web' %}{% set _ = cli_commands.append("web") %}{% endif -%}
{%- if include_mcp and primary_component != 'mcp' %}{% set _ = cli_commands.append("mcp") %}{% endif -%}
{%- if include_worker and primary_component != 'worker' %}{% set _ = cli_commands.append("worker") %}{% endif -%}
{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "--tb=short"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "justMyCode": false
    },
    {% if include_web %}
    {
      "name": "Python: Web App (dev)",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": false,
      "module": "{{github_repo_name}}",
      "args": ["dev"]
    },
    {% endif %}
    {% if include_cli %}
    {
      "name": "Python: CLI",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": true,
      "module": "uv",
      "args": ["run", "{{github_repo_name}}", "${input:command}"]
    },
    {% endif %}
    {% if include_tui %}
    {
      "name": "Python: TUI",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": true,
      "module": "uv",
      "args": ["run", "{{github_repo_name}}"{% if primary_component != 'tui' %}, "interactive"{% endif %}]
    },
    {% endif %}
    {% if include_gui %}
    {
      "name": "Python: GUI",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": true,
      "module": "uv",
      "args": ["run", "{{github_repo_name}}"{% if primary_component != 'gui' %}, "gui"{% endif %}]
    },
    {% endif %}
    {% if include_profiling %}
    {
      "name": "Python: With Profiling",
      "type": "debugpy",
      "request": "launch",
      "module": "scalene",
      "args": ["--cpu", "--memory", "${file}"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
    {% endif %}
  ],
  "inputs": [
{%- if include_cli %}
    // A pickString, not a promptString: VS Code substitutes an input into a
    // single `args` element and debugpy passes it verbatim, with no shell
    // splitting — so free text can never express more than one bare token
    // ("version --help" arrives as one argument and fails). Constraining the
    // input to the subcommands this project actually renders removes the need
    // to split. Add flags by editing the `args` array directly.
    {
      "id": "command",
      "type": "pickString",
      "options": [{% for command in cli_commands %}"{{ command }}"{% if not loop.last %}, {% endif %}{% endfor %}],
      "default": "version",
      "description": "The {{github_repo_name}} command to debug"
    }
{%- endif %}
  ]
}
