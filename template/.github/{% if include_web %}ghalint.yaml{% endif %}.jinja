---
# ghalint configuration. See https://github.com/suzuki-shunsuke/ghalint.
#
# Each entry below excludes ghalint's job_secrets policy for exactly one job
# that deliberately exposes a secret (or a presence-flag derived from one) at
# the *job* env level. GitHub makes neither the `secrets` context nor
# step-level env available to a step's `if:` condition, so a job whose steps
# gate on a secret via `env.SOME_TOKEN`/`env.SOME_TOKEN_SET` in their `if:`
# must publish that value job-wide. ghalint's job_secrets policy cannot know
# this is intentional, so it is excluded for exactly the jobs below. Every
# other policy stays at ghalint's strict defaults.
#
# docker-publish-preflight and docker-publish expose DOCKERHUB_USERNAME (not
# sensitive; DOCKERHUB_TOKEN is never surfaced job-wide — only as a `!= ''`
# presence flag and at the login step).
excludes:
  - policy_name: job_secrets
    workflow_file_path: .github/workflows/release.yml
    job_name: docker-publish-preflight
  - policy_name: job_secrets
    workflow_file_path: .github/workflows/release.yml
    job_name: docker-publish
