---
name: Release
on:
  workflow_dispatch:
  push:
    branches:
      - main
permissions: {}
jobs:
  release-please:
    runs-on: ubuntu-latest
    name: Release Please
    timeout-minutes: 10
    permissions:
      contents: write
      issues: write  # IMPORTANT: release-please manages PR labels via the Issues API
      pull-requests: write
    outputs:
      release_created: {% raw %}${{ steps.release.outputs.release_created }}{% endraw %}
      tag_name: {% raw %}${{ steps.release.outputs.tag_name }}{% endraw %}
      version: {% raw %}${{ steps.release.outputs.version }}{% endraw %}
    steps:
      - name: Release Please
        id: release
        uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7  # v5.0.0
        with:
          config-file: .github/release-please-config.json
          manifest-file: .github/release-please-manifest.json
  build:
    needs: release-please
    timeout-minutes: 15
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    permissions:
      contents: read  # IMPORTANT: actions/checkout needs read access to the repo
{%- if include_c_extensions %}
    name: Build the Package on {% raw %}${{ matrix.os }}{% endraw %}
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
{%- else %}
    runs-on: ubuntu-latest
    name: Build the Package
{%- endif %}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          # hatch-vcs derives the version from the git tag, so fetch full history
          # and tags. `force-tag-creation` in the release-please config makes
          # release-please create the tag immediately — GitHub otherwise withholds
          # a draft release's tag until it is published, which would make hatch-vcs
          # stamp the previous version.
          fetch-depth: 0
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        id: setup-uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Restore cache
        if: steps.setup-uv.outputs.cache-hit == 'true'
        run: echo "Cache was restored"
{%- if include_c_extensions %}
      - name: Build the wheel
        run: uv build --wheel --no-sources --quiet
      - name: Build the source distribution
        if: {% raw %}${{ matrix.os == 'ubuntu-latest' }}{% endraw %}
        run: uv build --sdist --no-sources --quiet
      - name: Upload package
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: package-distributions-{% raw %}${{ matrix.os }}{% endraw %}
          path: dist/
{%- else %}
      - name: Build the Package
        run: uv build --no-sources --quiet
      - name: Upload package
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: package-distributions
          path: dist/
{%- endif %}
  pypi-publish:
    runs-on: ubuntu-latest
    name: Publish to PyPI
    timeout-minutes: 10
    {#- Publishing to PyPI is irreversible, so it must not race ahead of the
        Docker Hub credentials preflight: gate it on the same check that gates
        docker-publish, or a half-configured secret pair would still let the
        package publish and then strand the release half-finished. #}
    needs: [release-please, build{% if include_web %}, docker-publish-preflight{% endif %}]
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    permissions:
      id-token: write  # IMPORTANT: Mandatory for Trusted Publishing (gh-action-pypi-publish)
    # Specifying a GitHub environment is optional, but strongly encouraged
    environment:
      name: publish
      url: https://pypi.org/project/{{github_repo_name}}/{% raw %}${{ needs.release-please.outputs.version }}{% endraw %}
    steps:
      - name: Download package
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8
        with:
{%- if include_c_extensions %}
          pattern: package-distributions-*
          path: dist/
          merge-multiple: true
{%- else %}
          name: package-distributions
          path: dist/
{%- endif %}
      - name: Publish distribution to PyPI
        uses: pypa/gh-action-pypi-publish@dc37677b2e1c63e2034f94d8a5b11f265b73ba33  # release/v1
{%- if include_launcher %}
  build-launcher:
    name: Build Launcher (PyCrucible)
    timeout-minutes: 20
    needs: [release-please, build]
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    permissions:
      contents: read  # IMPORTANT: actions/checkout needs read access to the repo
    strategy:
      fail-fast: false
      matrix:
        # label makes each binary's filename unique per OS (and per tool across
        # jobs), so download-artifact's merge-multiple and the release asset names
        # never collide. PyCrucible names via output:/`-o` + a `*` upload glob, so
        # no per-OS `ext` is needed here (unlike the freezer's post-build mv).
        # See ADR-007.
        include:
          - os: ubuntu-latest
            label: linux
          - os: windows-latest
            label: windows
          - os: macos-latest
            label: macos
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          # PyCrucible embeds the source tree; hatch-vcs needs full history + tags
          # to stamp the correct version into the embedded project (mirrors `build`).
          fetch-depth: 0
          persist-credentials: false
      - name: Build with PyCrucible
        uses: razorblade23/pycrucible-action@fcd0e906edafca9e4838f311eab47e03ef38115a  # v4
        with:
          source: '.'
          output: './dist/{{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}'
      - name: Upload executable
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: {{github_repo_name}}-executable-launcher-{% raw %}${{ matrix.os }}{% endraw %}
          # Glob so the upload succeeds whether or not the tool added an extension.
          path: './dist/{{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}*'
{%- endif %}
{%- if include_freezer %}
  build-freezer:
    name: Build Freezer (PyInstaller)
    timeout-minutes: 20
    needs: [release-please, build]
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    permissions:
      contents: read  # IMPORTANT: actions/checkout needs read access to the repo
    strategy:
      fail-fast: false
      matrix:
        # label/ext make each binary's filename unique per OS (and per tool across
        # jobs), so download-artifact's merge-multiple and the release asset names
        # never collide. See ADR-007.
        include:
          - os: ubuntu-latest
            label: linux
            ext: ""
          - os: windows-latest
            label: windows
            ext: ".exe"
          - os: macos-latest
            label: macos
            ext: ""
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Build with PyInstaller
        # The spec's static name="{{github_repo_name}}" can't see the matrix, so
        # rename the built binary to a unique per-OS name afterwards (bash is used
        # for a portable mv across the Linux/macOS/Windows runners).
        shell: bash
        run: |
          uv run --locked --group tool pyinstaller {{github_repo_name}}.spec --clean --noconfirm
          mv "dist/{{github_repo_name}}{% raw %}${{ matrix.ext }}{% endraw %}" "dist/{{github_repo_name}}-freezer-{% raw %}${{ matrix.label }}${{ matrix.ext }}{% endraw %}"
      - name: Upload executable
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: {{github_repo_name}}-executable-freezer-{% raw %}${{ matrix.os }}{% endraw %}
          path: './dist/{{github_repo_name}}-freezer-{% raw %}${{ matrix.label }}${{ matrix.ext }}{% endraw %}'
{%- endif %}
{%- if include_compiler %}
  build-compiler:
    name: Build Compiler (Nuitka)
    timeout-minutes: 20
    needs: [release-please, build]
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    permissions:
      contents: read  # IMPORTANT: actions/checkout needs read access to the repo
    strategy:
      fail-fast: false
      matrix:
        # label/ext make each binary's filename unique per OS (and per tool across
        # jobs), so download-artifact's merge-multiple and the release asset names
        # never collide. See ADR-007.
        include:
          - os: ubuntu-latest
            label: linux
            ext: ""
          - os: windows-latest
            label: windows
            ext: ".exe"
          - os: macos-latest
            label: macos
            ext: ""
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Build with Nuitka
        # --output-filename gives a unique per-OS name (Nuitka otherwise emits
        # "__main__.bin"/".exe", which is neither project- nor OS-specific). For a
        # GUI app on Windows, suppress the console window with
        # --windows-console-mode=disable (mirrors the freezer's console=False); the
        # flag is Windows-only, so it is matrix-gated to avoid erroring elsewhere.
        # macOS needs no equivalent — a --onefile binary launched from Finder runs
        # without a terminal — and --macos-create-app-bundle is deliberately NOT
        # used: it emits a .app *directory*, which would break the single-file
        # verify/upload steps (and the merge-multiple release attach). See ADR-007.
        run: uv run --locked --group tool python -m nuitka --onefile --assume-yes-for-downloads --warn-implicit-exceptions --warn-unusual-code {% if include_gui %}{% raw %}${{ matrix.os == 'windows-latest' && '--windows-console-mode=disable' || '' }}{% endraw %} {% endif %}--output-filename={{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %} --output-dir=dist src/{{github_repo_name}}/__main__.py
      - name: Upload executable
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: {{github_repo_name}}-executable-compiler-{% raw %}${{ matrix.os }}{% endraw %}
          # Glob so the upload succeeds whether or not the tool added an extension.
          path: './dist/{{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %}*'
{%- endif %}
{%- if include_web %}
  docker-publish-preflight:
    name: Validate Docker Hub Credentials
    timeout-minutes: 5
    needs: release-please
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    runs-on: ubuntu-latest
    permissions: {}
    env:
      # The `secrets` context is not available in `if:` conditions, so surface
      # the username through env. The token is reduced to a presence flag —
      # never expose the value job-wide.
      DOCKERHUB_USERNAME: {% raw %}${{ secrets.DOCKERHUB_USERNAME }}{% endraw %}
      DOCKERHUB_TOKEN_SET: {% raw %}${{ secrets.DOCKERHUB_TOKEN != '' }}{% endraw %}
    steps:
      # Docker Hub publishing is opt-in via the DOCKERHUB_USERNAME/-TOKEN secret
      # pair, which is all-or-nothing: half-configured means the maintainer
      # intended to publish there but it cannot work. This job gates every
      # publish job (pypi-publish and docker-publish), so an inconsistent
      # configuration blocks the whole publish fan-out up front — otherwise the
      # irreversible PyPI upload could complete while Docker Hub fails, leaving
      # a stranded half-release.
      - name: Fail on half-configured Docker Hub credentials
        if: {% raw %}${{ (env.DOCKERHUB_USERNAME != '') != (env.DOCKERHUB_TOKEN_SET == 'true') }}{% endraw %}
        run: |
          echo "::error::Docker Hub publishing is half-configured: set both the DOCKERHUB_USERNAME and DOCKERHUB_TOKEN repository secrets, or neither to publish to GHCR only."
          exit 1
      - name: Note GHCR-only publishing
        if: {% raw %}${{ env.DOCKERHUB_USERNAME == '' }}{% endraw %}
        run: echo "::notice::DOCKERHUB_USERNAME/DOCKERHUB_TOKEN secrets are not set — skipping Docker Hub, publishing to GHCR only."
  docker-publish:
    name: Publish Docker Image
    timeout-minutes: 15
    needs: [release-please, build, docker-publish-preflight]
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    env:
      # The `secrets` context is not available in `if:` conditions, so surface
      # the username through env to gate the optional Docker Hub login.
      DOCKERHUB_USERNAME: {% raw %}${{ secrets.DOCKERHUB_USERNAME }}{% endraw %}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up QEMU
        uses: docker/setup-qemu-action@96fe6ef7f33517b61c61be40b68a1882f3264fb8  # v4
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c  # v4
      - name: Log in to Docker Hub
        if: {% raw %}${{ env.DOCKERHUB_USERNAME != '' }}{% endraw %}
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f  # v4
        with:
          username: {% raw %}${{ secrets.DOCKERHUB_USERNAME }}{% endraw %}
          password: {% raw %}${{ secrets.DOCKERHUB_TOKEN }}{% endraw %}
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f  # v4
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Extract metadata (tags, labels)
        id: meta
        uses: docker/metadata-action@dc802804100637a589fabce1cb79ff13a1411302  # v6
        with:
          # The Docker Hub namespace is the Docker Hub username, which need not
          # match the GitHub owner — so build the image name from the secret,
          # not from github.repository. An empty line is dropped by the action,
          # which is what makes the Docker Hub channel opt-in.
          images: |
            {% raw %}${{ env.DOCKERHUB_USERNAME != '' && format('docker.io/{0}/{1}', env.DOCKERHUB_USERNAME, github.event.repository.name) || '' }}{% endraw %}
            ghcr.io/{% raw %}${{ github.repository }}{% endraw %}
          # No tag ref is present on a push-triggered run, so feed the
          # release-please version into the semver patterns explicitly.
          tags: |
            type=semver,pattern={{"{{"}}version{{"}}"}},value={% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
            type=semver,pattern={{"{{"}}major{{"}}"}}.{{"{{"}}minor{{"}}"}},value={% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
            type=semver,pattern={{"{{"}}major{{"}}"}},value={% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
            type=raw,value=latest,enable={{"{{"}}is_default_branch{{"}}"}}
            type=sha,prefix=
      - name: Build and push Docker image
        uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a  # v7
        with:
          context: .
          platforms: linux/amd64,linux/arm64
          push: true
          tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
          labels: {% raw %}${{ steps.meta.outputs.labels }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
{%- endif %}
  sbom:
    name: Generate SBOM (CycloneDX)
    timeout-minutes: 10
    needs: release-please
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    runs-on: ubuntu-latest
    permissions:
      contents: read  # IMPORTANT: actions/checkout needs read access to the repo
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Export locked runtime dependencies
        # SBOM describes what ships: the resolved runtime tree, excluding dev
        # tooling and the project. Component/settings deps are core
        # `dependencies`, so a plain export already covers them; `--all-extras`
        # is retained as a harmless safeguard should a future extra ship deps.
        run: uv export --frozen --all-extras --no-dev --no-emit-project --format requirements.txt --output-file requirements-sbom.txt
      - name: Generate CycloneDX SBOM
        run: uvx --from cyclonedx-bom cyclonedx-py requirements requirements-sbom.txt --output-format JSON --output-file {{github_repo_name}}-sbom.cdx.json
      - name: Upload SBOM
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: {{github_repo_name}}-sbom
          path: {{github_repo_name}}-sbom.cdx.json
  attach-github-release:
    runs-on: ubuntu-latest
    name: Attach Build Artifacts to GitHub Release
    timeout-minutes: 10
    needs: [release-please, pypi-publish, sbom{% if include_launcher %}, build-launcher{% endif %}{% if include_freezer %}, build-freezer{% endif %}{% if include_compiler %}, build-compiler{% endif %}]
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    permissions:
      contents: write  # IMPORTANT: Mandatory for GitHub Release
    steps:
      - name: Download package
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8
        with:
{%- if include_c_extensions %}
          pattern: package-distributions-*
          path: dist/
          merge-multiple: true
{%- else %}
          name: package-distributions
          path: dist/
{%- endif %}
{%- if include_launcher or include_freezer or include_compiler %}
      - name: Download executables
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8
        with:
          pattern: {{github_repo_name}}-executable-*
          path: dist/executables/
          merge-multiple: true
{%- endif %}
      - name: Download SBOM
        # Lands in dist/ so the CycloneDX SBOM is attached to the release
        # alongside the distributions by the upload step below.
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8
        with:
          name: {{github_repo_name}}-sbom
          path: dist/
      - name: Attach Build Artifacts to the draft release
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          # Pass GitHub context through env, never interpolated into the shell.
          TAG_NAME: {% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
        shell: bash
        run: |
          # Upload every file under dist/{% if include_launcher or include_freezer or include_compiler %} (executables land in dist/executables/, so a
          # plain ./dist/* glob would pass that subdirectory to gh, which rejects dirs){% endif %}.
          # Guard the empty case first: `xargs` with no input never invokes gh and
          # exits 0, which would silently publish a release with zero assets attached.
          test "$(find dist -type f | wc -l)" -gt 0 \
            || { echo "::error::no artifacts found under dist/ to attach to the release"; exit 1; }
          find dist -type f -print0 | xargs -0 gh release upload "$TAG_NAME" --clobber --repo "$REPO"
  finalize-release:
    runs-on: ubuntu-latest
    name: Publish the GitHub Release
    timeout-minutes: 10
    needs: {% if include_web %}[release-please, pypi-publish, attach-github-release, docker-publish]{% else %}[release-please, pypi-publish, attach-github-release]{% endif %}
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    permissions:
      contents: write  # IMPORTANT: Mandatory to un-draft the GitHub Release
      pull-requests: write  # IMPORTANT: Mandatory to close the phantom release PR
      actions: write  # IMPORTANT: Mandatory to re-dispatch this workflow
    steps:
      - name: Publish the draft release
        # KNOWN COSMETIC LIMITATION (accepted, see ADR-002): while the release is
        # a draft it has no public tag page, so its URL is a transient
        # `/releases/tag/untagged-<hash>` slug. release-please writes its
        # "🤖 Created releases:" comment on the merged release PR once, at
        # draft-creation time, capturing that slug — and never rewrites it. When
        # this step un-drafts the release GitHub moves it to
        # `/releases/tag/<TAG_NAME>` and the `untagged-…` link 404s. This is a
        # dead link on an already-merged PR, not a broken release: the release,
        # its tag, artifacts, and SBOM are all correct. Left as-is on purpose —
        # `draft: false` would fix the link but reintroduce a window where a
        # public release exists with no artifacts/SBOM attached (a worse trade).
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          TAG_NAME: {% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
        run: gh release edit "$TAG_NAME" --draft=false --repo "$REPO"
      - name: Reconcile the next release PR against the now-published release
        # release-please derives its commit range from the latest *published*
        # GitHub Release and ignores drafts. The release-please job above may have
        # opened the next release PR in this same run while this release was still
        # a draft, so that PR was computed with no baseline and re-lists shipped
        # commits as a phantom bump. release-please will NOT self-heal: a later
        # run with no new commits just skips, leaving the orphan PR open. So close
        # it now that the release is published, then re-dispatch. The re-dispatch
        # sees the published release and recreates a CORRECT next PR only if real
        # unreleased commits exist; otherwise it stops without reaching this job,
        # so the re-trigger is bounded to one run. (workflow_dispatch is the
        # documented exception to GITHUB_TOKEN loop-prevention, so no PAT needed.)
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          # GitHub-context values are read through env and referenced as shell
          # vars rather than interpolated inline, per the repo's no-untrusted-
          # context-in-run convention (this also satisfies zizmor's
          # template-injection audit). This workflow runs only on push to main /
          # workflow_dispatch, so these values are not fork-controlled here; the
          # indirection is kept as uniform hygiene.
          REPO: {% raw %}${{ github.repository }}{% endraw %}
          REF_NAME: {% raw %}${{ github.ref_name }}{% endraw %}
          WORKFLOW: {% raw %}${{ github.workflow }}{% endraw %}
        run: |
          pr="$(gh pr list --state open \
            --repo "$REPO" \
            --head "release-please--branches--$REF_NAME" \
            --json number --jq '.[0].number // empty')"
          if [ -n "$pr" ]; then
            echo "Closing phantom release PR #$pr"
            gh pr close "$pr" --delete-branch --repo "$REPO"
          fi
          gh workflow run "$WORKFLOW" --ref "$REF_NAME" --repo "$REPO"
{%- if include_homebrew %}
  bump-homebrew:
    name: Bump Homebrew {% if primary_executable %}cask{% else %}formula{% endif %}
    needs: [release-please, finalize-release]
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions: {}
    steps:
      - name: Dispatch the tap update
        env:
          # PAT with Contents: write on the tap repo (NOT the repo GITHUB_TOKEN,
          # which cannot POST a cross-repo dispatch). Absent → skip, never fail.
          GH_TOKEN: {% raw %}${{ secrets.HOMEBREW_TAP_TOKEN }}{% endraw %}
          VERSION: {% raw %}${{ needs.release-please.outputs.version }}{% endraw %}
        run: |
          if [ -z "${GH_TOKEN:-}" ]; then
            echo "::warning::HOMEBREW_TAP_TOKEN not set; skipping Homebrew bump"
            exit 0
          fi
          echo "Dispatching {% if primary_executable %}update-cask{% else %}update-formula{% endif %} for {{github_repo_name}} $VERSION"
          gh api repos/{{github_user}}/homebrew-tap/dispatches \
            --method POST \
            -f event_type={% if primary_executable %}update-cask{% else %}update-formula{% endif %} \
            -f 'client_payload[{% if primary_executable %}cask{% else %}formula{% endif %}]={{github_repo_name}}' \
            -f "client_payload[version]=$VERSION"
{%- endif %}
{%- if include_scoop %}
  bump-scoop:
    name: Bump Scoop bucket
    needs: [release-please, finalize-release]
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions: {}
    steps:
      - name: Dispatch the bucket update
        env:
          GH_TOKEN: {% raw %}${{ secrets.SCOOP_BUCKET_TOKEN }}{% endraw %}
          VERSION: {% raw %}${{ needs.release-please.outputs.version }}{% endraw %}
        run: |
          if [ -z "${GH_TOKEN:-}" ]; then
            echo "::warning::SCOOP_BUCKET_TOKEN not set; skipping Scoop bump"
            exit 0
          fi
          echo "Dispatching update-manifest for {{github_repo_name}} $VERSION"
          gh api repos/{{github_user}}/scoop-bucket/dispatches \
            --method POST \
            -f event_type=update-manifest \
            -f 'client_payload[package]={{github_repo_name}}' \
            -f "client_payload[version]=$VERSION"
{%- endif %}
{%- if include_docs %}
  deploy-docs:
    runs-on: ubuntu-latest
    name: Deploy Docs
    timeout-minutes: 15
    # Deploy docs inline after the release is published. The `release: published`
    # event that finalize-release emits cannot trigger a separate workflow,
    # because events fired by the GITHUB_TOKEN do not start new workflow runs
    # (the workflow_dispatch exception is why finalize-release re-dispatches
    # itself above). So docs deployment must live in this workflow as a job.
    needs: [release-please, finalize-release]
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    permissions:
      contents: write  # IMPORTANT: Mandatory for GitHub Pages
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        id: setup-uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Restore cache
        if: steps.setup-uv.outputs.cache-hit == 'true'
        run: echo "Cache was restored"
      - name: Set reproducible build epoch
        # Pin Sphinx's "today"/copyright to the last commit date so the same
        # commit always renders the same docs output (reproducible-builds.org).
        run: echo "SOURCE_DATE_EPOCH=$(git log -1 --format=%ct)" >> "$GITHUB_ENV"
      - name: Fetch gh-pages branch
        # build_docs.py preserves already-published versions from gh-pages; make
        # the branch available locally (no-op on the very first release).
        run: git fetch origin gh-pages:gh-pages || echo "gh-pages does not exist yet"
      - name: Build versioned docs
        env:
          PYTHONUNBUFFERED: "1"
          # Passed via env (not interpolated into run:) — read by the Python
          # process, so no template-injection surface. See ADR-027 / CLAUDE.md.
          DOCS_BUILD_VERSION: {% raw %}${{ needs.release-please.outputs.version }}{% endraw %}
        # Builds only this release's docs, then assembles ./site with every prior
        # version copied from gh-pages, a `latest` alias, and a root redirect.
        run: uv run --no-default-groups --extra all --group docs python tools/build_docs.py site
      - name: Deploy to GitHub Pages
        # Publishes the assembled ./site to gh-pages. The action does its own git
        # auth from the token input (default github.token) without writing it to
        # .git/config, so the checkout above keeps persist-credentials: false.
        # sphinx.ext.githubpages emits .nojekyll so _static/ is served.
        uses: JamesIves/github-pages-deploy-action@d92aa235d04922e8f08b40ce78cc5442fcfbfa2f  # v4.8.0
        with:
          folder: site
          # Preserve the PR preview tree (pr-preview/**) that docs-preview.yml
          # maintains — the action's default clean: true would otherwise wipe it.
          # Version directories (vX.Y/**) are re-supplied in ./site each run, so
          # clean is safe for them. Disable force-push so a concurrent preview
          # deploy is not clobbered. See ADR-010 / ADR-027.
          clean-exclude: pr-preview/**
          force: false
{%- endif %}
  notify-released-issues:
    runs-on: ubuntu-latest
    name: Notify released issues
    timeout-minutes: 10
    # Runs after the release is published (un-drafted) so the comment links a
    # live release page. Best-effort: a failure here never affects the already
    # published release or packages. See ADR-010.
    needs: [release-please, finalize-release]
    if: {% raw %}${{ needs.release-please.outputs.release_created == 'true' }}{% endraw %}
    permissions:
      issues: write  # IMPORTANT: comment on the issues this release closed
      contents: read  # IMPORTANT: read commits to map the release to issues
      pull-requests: read  # IMPORTANT: listPullRequestsAssociatedWithCommit needs this
    steps:
      - name: Comment on issues closed by this release
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3  # v9.0.0
        env:
          # GitHub-context values pass through env, never interpolated into the
          # script body (read via process.env) — the repo's no-untrusted-context
          # convention and zizmor's template-injection audit. These come from the
          # release-please outputs on a push-to-main run, so they are not
          # fork-controlled; the indirection is uniform hygiene.
          TAG_NAME: {% raw %}${{ needs.release-please.outputs.tag_name }}{% endraw %}
          VERSION: {% raw %}${{ needs.release-please.outputs.version }}{% endraw %}
        with:
          script: |
            const tag = process.env.TAG_NAME;
            const version = process.env.VERSION;
            const { owner, repo } = context.repo;

            // The previous published release delimits this release's commit range.
            const releases = await github.paginate(github.rest.repos.listReleases, {
              owner, repo, per_page: 100,
            });
            const previous = releases.find((r) => !r.draft && r.tag_name !== tag);
            if (!previous) {
              core.info("No previous release found; nothing to notify.");
              return;
            }

            // Commits in (previous, this] release, then the PRs that carried them.
            // Paginate explicitly: the compare endpoint caps at 250 commits per
            // page, so a large release would otherwise silently miss the tail. The
            // iterator reads each page's `data.commits` (unambiguous, unlike
            // relying on paginate() to normalize the compare response shape).
            const prNumbers = new Set();
            const pages = github.paginate.iterator(github.rest.repos.compareCommitsWithBasehead, {
              owner, repo, basehead: `${previous.tag_name}...${tag}`, per_page: 100,
            });
            for await (const { data } of pages) {
              for (const commit of data.commits || []) {
                const { data: prs } = await github.rest.repos.listPullRequestsAssociatedWithCommit({
                  owner, repo, commit_sha: commit.sha,
                });
                for (const pr of prs) prNumbers.add(pr.number);
              }
            }

            // The issues each PR declared it closes (the real Development link,
            // not just body text).
            const issues = new Set();
            const query = "query ($owner: String!, $repo: String!, $pr: Int!) { repository(owner: $owner, name: $repo) { pullRequest(number: $pr) { closingIssuesReferences(first: 50) { nodes { number } } } } }";
            for (const pr of prNumbers) {
              const result = await github.graphql(query, { owner, repo, pr });
              const nodes = result.repository.pullRequest?.closingIssuesReferences?.nodes || [];
              for (const node of nodes) issues.add(node.number);
            }
            if (issues.size === 0) {
              core.info("No closed issues linked to this release.");
              return;
            }

            const { data: release } = await github.rest.repos.getReleaseByTag({ owner, repo, tag });
            const body = `🎉 This was addressed in [\`${version}\`](${release.html_url}), which has just been released.`;
            for (const number of issues) {
              try {
                await github.rest.issues.createComment({ owner, repo, issue_number: number, body });
                core.info(`Commented on #${number}`);
              } catch (error) {
                core.warning(`Could not comment on #${number}: ${error.message}`);
              }
            }
