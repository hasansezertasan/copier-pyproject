---
name: All Contributors
# Regenerates the README contributors table from .all-contributorsrc using the
# all-contributors CLI and opens a PR with any change. This makes the
# include_all_contributors toggle usable without installing the all-contributors
# bot; the bot remains an alternative for `@all-contributors please add ...`
# comment-driven edits. See ADR-009.
#
# It opens a PR (via create-pull-request) rather than pushing to the default
# branch, so it respects the squash-merge policy and needs no persisted git
# credentials — the action authenticates its own push from its `token` input.
# Requires the repo's "Allow GitHub Actions to create and approve pull requests"
# setting (already required + documented for release-please).
on:
  workflow_dispatch:
  push:
    branches: [main, master]
    paths:
      - .all-contributorsrc
permissions: {}
jobs:
  generate:
    name: Regenerate contributors table
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write  # IMPORTANT: create-pull-request commits to a new branch
      pull-requests: write  # IMPORTANT: create-pull-request opens the PR
    steps:
      - name: Checkout repository
        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0  # v7
        with:
          persist-credentials: false
      - name: Install mise tools
        # all-contributors-cli is pinned in mise.toml (npm backend, Renovate-tracked)
        # and run via `mise exec`, mirroring how the ghalint hook is invoked.
        uses: jdx/mise-action@e6a8b3978addb5a52f2b4cd9d91eafa7f0ab959d  # v4.2.0
      - name: Regenerate the contributors table
        # Node (needed to run the CLI) is preinstalled on the runner.
        run: mise exec -- all-contributors generate
      - name: Open a PR with any changes
        uses: peter-evans/create-pull-request@5f6978faf089d4d20b00c7766989d076bb2fc7f1  # v8.1.1
        with:
          token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          branch: chore/all-contributors
          delete-branch: true
          commit-message: "docs: update the all-contributors list"
          title: "docs: update the all-contributors list"
          body: |
            Regenerated the contributors table from `.all-contributorsrc` with the
            all-contributors CLI.
