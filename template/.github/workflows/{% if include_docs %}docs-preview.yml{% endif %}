---
name: Docs Preview
# Deploys a live documentation preview for each pull request to a
# pr-preview/pr-<N>/ subfolder of the gh-pages branch and maintains a sticky
# comment with the preview URL. The preview is removed when the PR closes. The
# release docs deploy (release.yml `deploy-docs`) and the manual
# gh-pages.yml publish to the branch *root* and set `clean-exclude: pr-preview/**`
# so a release never wipes live previews. See https://hasansezertasan.github.io/copier-pyproject/context/docs-stack/#pr-docs-previews-deploy-to-a-subfolder-of-the-projects-own-gh-pages-same-repo-only.
#
# Same-repo PRs only: a fork PR's GITHUB_TOKEN is read-only and cannot deploy, so
# the `if` guard skips forks cleanly rather than failing (fork-preview support is
# planned for rossjrw/pr-preview-action v2). Plain `pull_request` (not
# pull_request_target), and two jobs: `build` runs the PR's own code (conf.py,
# dependencies) with a read-only token and hands the HTML over as an artifact;
# `deploy` holds the write token but never checks out or executes PR code, so a
# compromised branch or dependency PR cannot push to gh-pages or edit PRs.
on:
  pull_request:
    branches: [main, master]
    types: [opened, synchronize, reopened, closed]
permissions: {}
# Serialize preview deploys per PR so rapid pushes (synchronize) can't race or
# land out of order on gh-pages. Do not cancel in-flight runs: a cancelled deploy
# could leave the preview half-updated, so let each finish.
concurrency:
  group: docs-preview-${{ github.event.pull_request.number }}
  cancel-in-progress: false
jobs:
  build:
    name: Build docs preview
    if: >-
      github.event.pull_request.head.repo.full_name == github.repository && github.event.action != 'closed'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
          # sphinx-last-updated-by-git needs the full history; on a depth-1 clone
          # it warns "Git clone too shallow" on every page and the warning gate
          # in the build step below turns each one into an error. Also what the
          # "Set reproducible build epoch" step reads `git log -1` from.
          fetch-depth: 0
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7  # v10.2.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Set reproducible build epoch
        # Pin Sphinx's "today"/copyright to the last commit date so the same
        # commit always renders the same docs output (reproducible-builds.org).
        run: echo "SOURCE_DATE_EPOCH=$(git log -1 --format=%ct)" >> "$GITHUB_ENV"
      - name: Build docs
        # sphinx.ext.githubpages emits .nojekyll so _static/ is served.
        env:
          PYTHONUNBUFFERED: "1"
        # Build with -w (warning stream to file) + the allowlist gate, matching
        # the docs-build tox env, so PR previews fail on the same unexpected
        # warnings the local loop catches.
        run: |
          uv run --no-default-groups --group docs sphinx-build -w docs/_build/warnings.txt -b html docs docs/_build/html
          uv run --no-default-groups --group docs python docs/check_warnings.py
      - name: Upload docs artifact
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9  # v7.0.2
        with:
          name: docs-preview-html
          path: docs/_build/html
          if-no-files-found: error
          retention-days: 1
  deploy:
    name: Deploy docs preview
    needs: build
    # always() so a closed PR (build skipped) still removes its preview, while a
    # failed build never deploys.
    if: >-
      always() && github.event.pull_request.head.repo.full_name == github.repository && (needs.build.result == 'success' || github.event.action == 'closed')
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write  # IMPORTANT: deploy the preview to the gh-pages branch
      pull-requests: write  # IMPORTANT: maintain the sticky preview comment
    steps:
      # The default branch, never the PR ref: this job holds the write token, so
      # it must not have PR-controlled files in its workspace. The deploy action
      # only needs a git work tree to publish gh-pages from.
      - name: Checkout default branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          ref: ${{ github.event.repository.default_branch }}
          persist-credentials: false
      - name: Download docs artifact
        if: github.event.action != 'closed'
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333  # v8.0.2
        with:
          name: docs-preview-html
          path: docs/_build/html
      - name: Deploy preview
        # action: auto deploys on opened/synchronize/reopened and removes the
        # pr-preview/pr-<N>/ subfolder on closed; the sticky comment is updated
        # in both cases. The action authenticates from its `token` input
        # (default github.token) via github-pages-deploy-action, so the checkout
        # above keeps persist-credentials: false.
        uses: rossjrw/pr-preview-action@ffa7509e91a3ec8dfc2e5536c4d5c1acdf7a6de9  # v1.8.1
        with:
          source-dir: docs/_build/html
          preview-branch: gh-pages
          umbrella-dir: pr-preview
          action: auto
