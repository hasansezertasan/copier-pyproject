---
name: MegaLinter
# Optional (include_megalinter) extra CI quality layer. It runs ONLY linters that
# prek/tox do not already cover -- shellcheck, hadolint (web Dockerfile), jsonlint,
# and jscpd clone-detection -- and uploads SARIF findings to the Security tab.
# tox/prek remain the canonical, blocking style runners; this layer is
# non-blocking (not in the ci.yml `check` gate, no status reporter). It uses the
# smaller `cupcake` flavor image to cut the pull cost. No paths filter: jscpd
# scans source, so a filter would trigger on nearly every PR anyway -- an
# always-run is simpler and more predictable. See ADR-013.
on:
  workflow_dispatch:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]
permissions: {}
concurrency:
  group: mega-linter-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true
jobs:
  mega-linter:
    name: Run MegaLinter
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      security-events: write  # upload the MegaLinter SARIF to code scanning
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
          fetch-depth: 0
      - name: Run MegaLinter
        # `cupcake` flavor: smaller image than the default full flavor, yet still
        # contains every linter enabled in .mega-linter.yml. SHA-pinned and
        # Renovate-tracked like every other action.
        uses: oxsecurity/megalinter/flavors/cupcake@ef3e84b8b836d76db562d0f3ed7da61e8fd538bc  # v9
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          VALIDATE_ALL_CODEBASE: {% raw %}${{ github.event_name != 'pull_request' }}{% endraw %}
      - name: Upload SARIF to the code-scanning dashboard
        # Ingests MegaLinter's SARIF into the Security tab (code scanning) so
        # findings get stateful, incremental triage -- mirroring zizmor.yml.
        # Best-effort: code scanning is free on public repos and needs GitHub
        # Advanced Security on private ones, so this never fails the job.
        if: {% raw %}${{ always() }}{% endraw %}
        continue-on-error: true
        uses: github/codeql-action/upload-sarif@f205ea1c3313d32999d8d6a48b4f6530d4437b38  # v4
        with:
          sarif_file: megalinter-reports
      - name: Upload MegaLinter reports
        if: {% raw %}${{ always() }}{% endraw %}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: megalinter-reports
          path: megalinter-reports
          if-no-files-found: ignore
          retention-days: 7
