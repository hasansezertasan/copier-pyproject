        run: echo "::notice::SONAR_TOKEN secret is not set — skipping the SonarCloud scan. See docs/maintaining/setup.rst (Repository setup) to enable it."
{%- endif %}
  check:
    if: {% raw %}${{ always() && github.event.pull_request.draft != true }}{% endraw %}
    needs: [ci, coverage-combine, hooks{% if include_launcher %}, build-launcher-check{% endif %}{% if include_freezer %}, build-freezer-check{% endif %}{% if include_compiler %}, build-compiler-check{% endif %}{% if include_worker %}, worker-integration{% endif %}]
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions: {}
    steps:
      - name: Decide whether the needed jobs succeeded or failed
        uses: re-actors/alls-green@05ac9388f0aebcb5727afa17fcccfecd6f8ec5fe  # release/v1
