---
name: CI
on:
  workflow_dispatch:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]
    # `ready_for_review` is NOT in the default type set (opened, synchronize,
    # reopened) and is load-bearing here: every job below is gated on
    # `draft != true`, so without this type, taking a PR out of draft would
    # never re-run the CI it skipped while drafted. See ADR-028.
    types: [opened, synchronize, reopened, ready_for_review]
jobs:
  hooks:
    name: Run prek hooks
    # Draft PRs skip the whole workflow — including the `check` gate, so the
    # required status stays pending rather than failing (`alls-green` counts a
    # skipped `needs` job as a failure). `!= true` is falsy-safe on
    # `push`/`workflow_dispatch`, where there is no `pull_request` context. Every
    # job below carries the same guard; see ADR-028.
    if: {% raw %}${{ github.event.pull_request.draft != true }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        id: setup-uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Install mise tools
        # ghalint has no PyPI wrapper or pre-commit hook, so the prek `ghalint`
        # hook runs the mise-managed binary. Install mise's tools (incl. ghalint)
        # and put them on PATH before prek runs.
        uses: jdx/mise-action@7e36c90d9ab29c415a2384db3006f3ec8a8cc654  # v4.2.4
      - name: Run prek hooks
        run: uv run --locked --group prek prek run --all-files --show-diff-on-failure
  ci:
    if: {% raw %}${{ github.event.pull_request.draft != true }}{% endraw %}
{%- if include_c_extensions %}
    # Full grid: `include_c_extensions` makes each wheel ABI-specific (tox
    # `package = "sdist"`, so every interpreter compiles the extension itself), so
    # every OS × interpreter pair is a distinct build that must be verified. Every
    # cell gets the bare `tox run` (the whole `env_list`). This is the deliberate
    # carve-out from the asymmetric matrix below — see ADR-028.
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: windows-latest
            tox_args: ""
          - os: ubuntu-latest
            tox_args: ""
          - os: macos-latest
            tox_args: ""
{%- else %}
    # Asymmetric matrix: full interpreter depth on Linux, one representative
    # interpreter elsewhere. Every OS still runs the suite and every interpreter
    # still runs the suite, but not every pair — cross-platform bugs (path
    # separators, line endings, signals) are interpreter-independent and
    # interpreter bugs are OS-independent, so the full grid is largely redundant
    # spend (15 heavy runs → 5 + 1 + 1). `-e py` runs the single tox env for the
    # interpreter that invoked tox — i.e. the `.python-version` one `setup-python`
    # installs above — so these cells also skip the OS-independent lint/CLI envs
    # (`style`{% if include_cli %}, `cli`{% endif %}), already covered in the Linux cell. See ADR-028.
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-latest
            tox_args: ""
          - os: macos-latest
            tox_args: "-e py"
          - os: windows-latest
            tox_args: "-e py"
{%- endif %}
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    name: Run Tests on {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 10
    permissions:
      contents: read
    steps:
      - name: System Info
        shell: bash
        run: |
          if [[ {% raw %}${{ matrix.os }}{% endraw %} == "ubuntu-latest" ]]; then
              echo "The system is Linux."
              uname -a || true
              lsb_release -a || true
              gcc --version || true
          elif [[ {% raw %}${{ matrix.os }}{% endraw %} == "macos-latest" ]]; then
              echo "The system is macOS."
              sw_vers || true
              uname -a || true
              gcc --version || true
          elif [[ {% raw %}${{ matrix.os }}{% endraw %} == "windows-latest" ]]; then
              echo "The system is Windows (using a Unix-like environment)."
              systeminfo || true
          else
              echo "Unknown OS: $OS_TYPE"
              exit 1
          fi
      - name: Environment Info
        run: |
          env || true
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        id: setup-uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Restore cache
        if: steps.setup-uv.outputs.cache-hit == 'true'
        run: echo "Cache was restored"
      - name: Run the tests
        # `matrix.tox_args` selects this cell's depth — empty for the full
        # `env_list`, `-e py` for the single `.python-version` interpreter. Safe to
        # interpolate into `run:`: the values are literals from the matrix above,
        # not untrusted event input.
        run: uv run --locked tox run {% raw %}${{ matrix.tox_args }}{% endraw %}
      - name: Store coverage data
        # Combine this cell's per-interpreter data and hand the raw `.coverage`
        # off (under a per-OS name) to the `coverage-combine` job, which merges
        # every OS × interpreter cell into the single authoritative report and
        # enforces the one `fail_under` gate. The per-cell `coverage report` here
        # stays for fast per-OS feedback but does NOT gate (`--fail-under=0`): a
        # line covered on one OS yet version/OS-gated off on another only balances
        # in the union, so the gate must measure the union, not each cell. See
        # ADR-026.
        run: |
          uv run coverage combine
          uv run coverage report --show-missing --fail-under=0
          mv .coverage ".coverage.{% raw %}${{ matrix.os }}{% endraw %}"
      - name: Upload coverage data
        # `include-hidden-files` is required for upload-artifact to pick up the
        # dotfile `.coverage.*`. Downloaded and merged by `coverage-combine`.
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: coverage-{% raw %}${{ matrix.os }}{% endraw %}
          path: .coverage.{% raw %}${{ matrix.os }}{% endraw %}
          include-hidden-files: true
  coverage-combine:
    name: Combine coverage across the matrix
    if: {% raw %}${{ github.event.pull_request.draft != true }}{% endraw %}
    needs: ci
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
    env:
      # The `secrets` context is unavailable in `if:`, so surface CODECOV_TOKEN as
      # a presence flag — never expose the value job-wide. See the `ci` job.
      CODECOV_TOKEN_SET: {% raw %}${{ secrets.CODECOV_TOKEN != '' }}{% endraw %}
      REPO_IS_PUBLIC: {% raw %}${{ !github.event.repository.private }}{% endraw %}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
      - name: Download per-cell coverage data
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8
        with:
          pattern: coverage-*
          merge-multiple: true
      - name: Combine, gate, and render the report
        # The single place the `fail_under = 99` gate is enforced — over the union
        # of every OS × interpreter cell, not each cell independently.
        # `relative_files` (pyproject `[tool.coverage.run]`) lets paths from
        # different runners merge. `--locked --only-group test` pins the SAME
        # coverage version that produced the `.coverage.*` data files (rather than
        # an unpinned resolve that could drift), without building the project.
        run: |
          uv run --locked --only-group test coverage combine
          uv run --locked --only-group test coverage report --show-missing --fail-under=99
          uv run --locked --only-group test coverage html
          uv run --locked --only-group test coverage xml
      - name: Upload combined HTML report
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: coverage-html
          path: htmlcov
      - name: Upload coverage to Codecov
        # Single authoritative upload for the whole fan-out. Uploads when the token
        # is set or the repo is public (tokenless); only a private repo with no
        # token falls through to the visible skip below. Best-effort
        # (`fail_ci_if_error` defaults to false), so a rate-limit never breaks CI.
        if: {% raw %}${{ env.CODECOV_TOKEN_SET == 'true' || env.REPO_IS_PUBLIC == 'true' }}{% endraw %}
        uses: codecov/codecov-action@fb8b3582c8e4def4969c97caa2f19720cb33a72f  # v7.0.0
        with:
          files: ./coverage.xml
          token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
      - name: Note skipped coverage upload
        if: {% raw %}${{ env.CODECOV_TOKEN_SET != 'true' && env.REPO_IS_PUBLIC != 'true' }}{% endraw %}
        run: echo "::notice::CODECOV_TOKEN secret is not set and this repo is private — skipping the Codecov upload. See docs/maintaining/setup.rst (Repository setup) to enable coverage reporting."
{%- if include_sonarcloud %}
      - name: Upload combined coverage.xml for SonarCloud
        # The authoritative cross-matrix coverage.xml, consumed by the `sonar` job.
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: coverage-xml
          path: ./coverage.xml
{%- endif %}
{%- if include_smokeshow %}
      - name: Publish coverage HTML (public repos)
        # smokeshow uploads htmlcov to an ephemeral public URL and prints it — no
        # account or secret required (an optional key only raises rate limits).
        # Public repos only: a private report must not be published. Best-effort
        # and ordered LAST — a tokenless rate-limit or outage must never fail the
        # `check` gate nor block the authoritative Codecov/coverage.xml uploads
        # above; smokeshow is a supplementary mirror, not load-bearing. See ADR-026.
        if: {% raw %}${{ env.REPO_IS_PUBLIC == 'true' }}{% endraw %}
        continue-on-error: true
        run: uv run --no-project --with smokeshow smokeshow upload htmlcov
{%- endif %}
{%- if include_launcher or include_freezer or include_compiler %}
  # Build-only PR guards: build each enabled standalone executable (ADR-007)
  # against the PR diff so a dependency or Python bump that breaks packaging fails
  # HERE, against the offending change, instead of silently at release time. The
  # test suite always runs the source tree, never the built binary, so these jobs
  # are the only thing that exercises packaging before a release. Each verifies the
  # binary was produced and uploads a 7-day preview artifact a reviewer can
  # launch-test. A CLI project is additionally smoke-run with `--help`; non-CLI
  # entrypoints (GUI/TUI/web/MCP/worker) block on a UI/server loop and so are only
  # existence-checked here, never runtime-verified — a reviewer must launch the
  # preview artifact to confirm those actually run. They closely follow the
  # release.yml build jobs (same setup + build commands) but skip the
  # release-only steps (the freezer's per-OS rename, and publishing).
{%- endif %}
{%- if include_launcher %}
  build-launcher-check:
    if: {% raw %}${{ github.event.pull_request.draft != true }}{% endraw %}
    name: Build Launcher (PyCrucible) on {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-latest
            label: linux
          - os: windows-latest
            label: windows
          - os: macos-latest
            label: macos
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Build with PyCrucible
        uses: razorblade23/pycrucible-action@fcd0e906edafca9e4838f311eab47e03ef38115a  # v4
        with:
          source: '.'
          output: './dist/{{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}'
      - name: Verify the launcher was produced
        shell: bash
        run: |
          shopt -s nullglob
          files=(./dist/{{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}*)
          bin="${files[0]:-}"
          test -n "$bin" || { echo "::error::PyCrucible produced no launcher"; exit 1; }
          test -s "$bin" || { echo "::error::launcher is empty"; exit 1; }
          [ "$RUNNER_OS" = Windows ] || test -x "$bin" || { echo "::error::launcher is not executable"; exit 1; }
{%- if include_cli %}
      - name: Smoke-run the launcher (CLI --help)
        # First run bootstraps uv + downloads the interpreter, then runs the CLI.
        shell: bash
        run: |
          shopt -s nullglob
          files=(./dist/{{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}*)
          bin="${files[0]:-}"
          echo "Running $bin --help"
          "$bin" --help
{%- endif %}
      - name: Upload launcher preview
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: {{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}-preview
          path: './dist/{{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}*'
          retention-days: 7
{%- endif %}
{%- if include_freezer %}
  build-freezer-check:
    if: {% raw %}${{ github.event.pull_request.draft != true }}{% endraw %}
    name: Build Freezer (PyInstaller) on {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-latest
            ext: ""
          - os: windows-latest
            ext: ".exe"
          - os: macos-latest
            ext: ""
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Build with PyInstaller
        run: uv run --locked --group tool pyinstaller {{github_repo_name}}.spec --clean --noconfirm
      - name: Verify the bundle was produced
        shell: bash
        run: |
          bin="./dist/{{github_repo_name}}{% raw %}${{ matrix.ext }}{% endraw %}"
          test -s "$bin" || { echo "::error::PyInstaller produced no executable"; exit 1; }
          [ "$RUNNER_OS" = Windows ] || test -x "$bin" || { echo "::error::executable is not runnable"; exit 1; }
{%- if include_cli %}
      - name: Smoke-run the bundle (CLI --help)
        shell: bash
        run: |
          echo "Running ./dist/{{github_repo_name}}{% raw %}${{ matrix.ext }}{% endraw %} --help"
          "./dist/{{github_repo_name}}{% raw %}${{ matrix.ext }}{% endraw %}" --help
{%- endif %}
      - name: Upload freezer preview
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: {{github_repo_name}}-freezer-{% raw %}${{ matrix.os }}{% endraw %}-preview
          path: './dist/{{github_repo_name}}{% raw %}${{ matrix.ext }}{% endraw %}'
          retention-days: 7
{%- endif %}
{%- if include_compiler %}
  build-compiler-check:
    if: {% raw %}${{ github.event.pull_request.draft != true }}{% endraw %}
    name: Build Compiler (Nuitka) on {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-latest
            label: linux
          - os: windows-latest
            label: windows
          - os: macos-latest
            label: macos
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Build with Nuitka
        # GUI suppresses the Windows console window only (matrix-gated, Windows-only
        # flag); macOS needs no equivalent and --macos-create-app-bundle is avoided
        # because it emits a .app directory that breaks the single-file checks below.
        # See ADR-007 and the matching release.yml job.
        run: uv run --locked --group tool python -m nuitka --onefile --assume-yes-for-downloads --warn-implicit-exceptions --warn-unusual-code {% if include_gui %}{% raw %}${{ matrix.os == 'windows-latest' && '--windows-console-mode=disable' || '' }}{% endraw %} {% endif %}--output-filename={{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %} --output-dir=dist src/{{github_repo_name}}/__main__.py
      - name: Verify the binary was produced
        shell: bash
        run: |
          shopt -s nullglob
          files=(./dist/{{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %}*)
          bin="${files[0]:-}"
          test -n "$bin" || { echo "::error::Nuitka produced no binary"; exit 1; }
          test -s "$bin" || { echo "::error::binary is empty"; exit 1; }
          [ "$RUNNER_OS" = Windows ] || test -x "$bin" || { echo "::error::binary is not executable"; exit 1; }
{%- if include_cli %}
      - name: Smoke-run the binary (CLI --help)
        shell: bash
        run: |
          shopt -s nullglob
          files=(./dist/{{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %}*)
          bin="${files[0]:-}"
          echo "Running $bin --help"
          "$bin" --help
{%- endif %}
      - name: Upload compiler preview
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: {{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %}-preview
          path: './dist/{{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %}*'
          retention-days: 7
{%- endif %}
{%- if include_worker %}
  worker-integration:
    if: {% raw %}${{ github.event.pull_request.draft != true }}{% endraw %}
    name: Worker integration tests ({{worker_broker}})
    # Ubuntu-only: the real {{worker_broker}} runs in a Linux container — a
    # GitHub Actions service for redis/nats (below), an in-test testcontainer for
    # kafka/rabbitmq — and container support is Linux-runner-only. Runs only the
    # `integration`-marked tests (deselected from the default matrix in the `ci`
    # job) against a real {{worker_broker}} — the one thing that exercises the real
    # driver and serialization the in-memory unit tests stub out. See ADR-008.
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
{%- set ci_service = worker_broker_spec.get("ci_service") %}
{%- if ci_service %}
    # {{worker_broker}} starts fast, so CI uses a GitHub Actions service
    # container — started (and torn down) by the runner before the job — instead
    # of an in-test testcontainer. Setting {{worker_broker_spec.env}} makes the
    # integration test connect to it directly and skip container startup; a
    # local `pytest -m integration` (no env var) still uses testcontainers.
    # Which brokers get this path, and every value below, is derived from
    # `worker_broker_spec.ci_service` — see ADR-008 / issue #169.
    services:
      {{ci_service.name}}:
        image: {{ci_service.image}}
        ports:
          - {{ci_service.port}}:{{ci_service.port}}
{%- if ci_service.health_cmd %}
        options: >-
          --health-cmd "{{ci_service.health_cmd}}"
          --health-interval 5s
          --health-timeout 3s
          --health-retries 5
{%- else %}
        # No `--health-cmd`: this image ships no usable in-container health probe,
        # so the runner cannot gate on readiness. It boots in well under a second
        # and the checkout/Python/uv setup steps precede the first test line, so
        # the service is long ready by then; the integration test's own
        # connect-retry covers the rest. See ADR-008.
{%- endif %}
    env:
      {{worker_broker_spec.env}}: {{ci_service.url}}
{%- endif %}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Run worker integration tests
        run: uv run --locked tox run -e integration
{%- endif %}
{%- if include_sonarcloud %}
  sonar:
    name: SonarCloud Scan
    needs: coverage-combine
    # Opt-in and non-blocking, mirroring the Codecov upload: forks never receive
    # secrets and SonarCloud has no tokenless fallback, so skip fork PRs entirely;
    # on same-repo runs, the scan step is gated on the SONAR_TOKEN presence flag
    # (the `secrets` context is unavailable in `if:`) and records a visible skip
    # instead of failing when the secret is unset. Not wired into the `check`
    # aggregation gate — quality reporting is best-effort, not merge-blocking.
    if: {% raw %}${{ github.event.pull_request.head.repo.fork != true && github.event.pull_request.draft != true }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
    env:
      SONAR_TOKEN_SET: {% raw %}${{ secrets.SONAR_TOKEN != '' }}{% endraw %}
    steps:
      - name: Checkout repository
        # Full history so SonarCloud can attribute issues to blame/new-code.
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Download coverage.xml
        if: {% raw %}${{ env.SONAR_TOKEN_SET == 'true' }}{% endraw %}
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8
        with:
          name: coverage-xml
      - name: SonarCloud Scan
        if: {% raw %}${{ env.SONAR_TOKEN_SET == 'true' }}{% endraw %}
        uses: SonarSource/sonarqube-scan-action@22918119ff8e1ca75a623e15c8296b6ea4fbe28f  # v8.2.1
        env:
          SONAR_TOKEN: {% raw %}${{ secrets.SONAR_TOKEN }}{% endraw %}
