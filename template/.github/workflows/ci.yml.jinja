---
name: CI
on:
  workflow_dispatch:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]
jobs:
  changes:
    name: Detect changed components
    # Draft-skip composes with #159 and is falsy-safe on push/workflow_dispatch
    # (no pull_request context => the expression is not 'true', so it runs).
    if: {% raw %}${{ github.event.pull_request.draft != true }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
      # dorny/paths-filter fetches the changed-file list via the REST API on
      # `pull_request` events (git diff is only used for push/other events, even
      # with a checkout), so it needs `pull-requests: read`.
      pull-requests: read
    outputs:
      core: {% raw %}${{ steps.filter.outputs.core }}{% endraw %}
{%- if include_console_root %}
      cli: {% raw %}${{ steps.filter.outputs.cli }}{% endraw %}
{%- endif %}
{%- if include_web %}
      web: {% raw %}${{ steps.filter.outputs.web }}{% endraw %}
{%- endif %}
{%- if include_gui %}
      gui: {% raw %}${{ steps.filter.outputs.gui }}{% endraw %}
{%- endif %}
{%- if include_tui %}
      tui: {% raw %}${{ steps.filter.outputs.tui }}{% endraw %}
{%- endif %}
{%- if include_mcp %}
      mcp: {% raw %}${{ steps.filter.outputs.mcp }}{% endraw %}
{%- endif %}
{%- if include_worker %}
      worker: {% raw %}${{ steps.filter.outputs.worker }}{% endraw %}
{%- endif %}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Filter changed paths
        id: filter
        uses: dorny/paths-filter@ceb8a2b8f2d89434be7ff52d3de7ec3738c5cc9d  # v4.0.3
        with:
          # `core` underpins every component (deps, shared core/, package-root
          # modules, the root conftest, root-level tests), so a change here
          # forces the full fan-out — mirrors the import-linter layering
          # (ADR-014). Each component filter watches only its own src+tests tree.
          filters: |
            core:
              - 'pyproject.toml'
              - 'uv.lock'
              - 'tox.ini'
              - 'src/{{github_repo_name}}/*.py'
              - 'src/{{github_repo_name}}/core/**'
              - 'src/{{github_repo_name}}/utils/**'
              - 'tests/conftest.py'
              - 'tests/core/**'
              - 'tests/test_*.py'
{%- if include_console_root %}
            cli:
              - 'src/{{github_repo_name}}/cli/**'
              - 'tests/cli/**'
{%- endif %}
{%- if include_web %}
            web:
              - 'src/{{github_repo_name}}/web/**'
              - 'tests/web/**'
{%- endif %}
{%- if include_gui %}
            gui:
              - 'src/{{github_repo_name}}/gui/**'
              - 'tests/gui/**'
{%- endif %}
{%- if include_tui %}
            tui:
              - 'src/{{github_repo_name}}/tui/**'
              - 'tests/tui/**'
{%- endif %}
{%- if include_mcp %}
            mcp:
              - 'src/{{github_repo_name}}/mcp/**'
              - 'tests/mcp/**'
{%- endif %}
{%- if include_worker %}
            worker:
              - 'src/{{github_repo_name}}/worker/**'
              - 'tests/worker/**'
{%- endif %}
  hooks:
    name: Run prek hooks
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        id: setup-uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Install mise tools
        # ghalint has no PyPI wrapper or pre-commit hook, so the prek `ghalint`
        # hook runs the mise-managed binary. Install mise's tools (incl. ghalint)
        # and put them on PATH before prek runs.
        uses: jdx/mise-action@7e36c90d9ab29c415a2384db3006f3ec8a8cc654  # v4.2.4
      - name: Run prek hooks
        run: uv run --locked --group prek prek run --all-files --show-diff-on-failure
{#- Per-component test jobs (issue #160). `test-core` always runs; each
    `test-<component>` is path-gated on its own tree with `core` as the escape
    hatch. The core marker deselects every enabled component (integration tests
    live under tests/worker and are excluded by `not (worker)`); the worker job
    additionally drops its integration subset (run in `worker-integration`).
    The matrix shape mirrors #159 (full interpreter sweep on Linux, one
    representative interpreter elsewhere; full grid under c-extensions). -#}
{%- set comp_names = [] %}
{%- if include_console_root %}{% set _ = comp_names.append('cli') %}{% endif %}
{%- if include_web %}{% set _ = comp_names.append('web') %}{% endif %}
{%- if include_gui %}{% set _ = comp_names.append('gui') %}{% endif %}
{%- if include_tui %}{% set _ = comp_names.append('tui') %}{% endif %}
{%- if include_mcp %}{% set _ = comp_names.append('mcp') %}{% endif %}
{%- if include_worker %}{% set _ = comp_names.append('worker') %}{% endif %}
{%- if comp_names %}{% set core_marker = 'not (' ~ comp_names | join(' or ') ~ ')' %}{% else %}{% set core_marker = '' %}{% endif %}
{%- set test_jobs = [{'slug': 'core', 'marker': core_marker, 'gated': False}] %}
{%- for c in comp_names %}{% set _ = test_jobs.append({'slug': c, 'marker': c ~ (' and not integration' if c == 'worker' else ''), 'gated': True}) %}{% endfor %}
{% for job in test_jobs %}
  test-{{ job.slug }}:
    name: Test {{ job.slug }} on {% raw %}${{ matrix.os }}{% endraw %}
    needs: changes
{%- if job.gated %}
    if: >-
      {% raw %}${{ github.event.pull_request.draft != true &&
      (needs.changes.outputs.{% endraw %}{{ job.slug }}{% raw %} == 'true' ||
      needs.changes.outputs.core == 'true') }}{% endraw %}
{%- else %}
    if: {% raw %}${{ github.event.pull_request.draft != true }}{% endraw %}
{%- endif %}
    strategy:
      fail-fast: false
      matrix:
        include:
{%- if include_c_extensions %}
          - {os: ubuntu-latest, tox_args: ""}
          - {os: macos-latest, tox_args: ""}
          - {os: windows-latest, tox_args: ""}
{%- else %}
          - {os: ubuntu-latest, tox_args: ""}
          - {os: macos-latest, tox_args: "-e py"}
          - {os: windows-latest, tox_args: "-e py"}
{%- endif %}
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 10
    permissions:
      contents: read
    steps:
      - name: System Info
        shell: bash
        run: |
          if [[ {% raw %}${{ matrix.os }}{% endraw %} == "ubuntu-latest" ]]; then
              echo "The system is Linux."
              uname -a || true
              lsb_release -a || true
              gcc --version || true
          elif [[ {% raw %}${{ matrix.os }}{% endraw %} == "macos-latest" ]]; then
              echo "The system is macOS."
              sw_vers || true
              uname -a || true
              gcc --version || true
          elif [[ {% raw %}${{ matrix.os }}{% endraw %} == "windows-latest" ]]; then
              echo "The system is Windows (using a Unix-like environment)."
              systeminfo || true
          else
              echo "Unknown OS: $OS_TYPE"
              exit 1
          fi
      - name: Environment Info
        run: |
          env || true
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        id: setup-uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Restore cache
        if: steps.setup-uv.outputs.cache-hit == 'true'
        run: echo "Cache was restored"
      - name: Run the tests
        # `matrix.tox_args` selects the interpreter sweep (#159); the posargs
        # after `--` select this component's marked tests (issue #160).
        # `matrix.tox_args` is a workflow-defined (trusted) context, used inline
        # like `matrix.os` in the System Info step — not untrusted GitHub context.
        run: uv run --locked tox run {% raw %}${{ matrix.tox_args }}{% endraw %}{% if job.marker %} -- -m "{{ job.marker }}"{% endif %}

      - name: Store coverage data
        # Combine this cell's per-interpreter data and hand the raw `.coverage`
        # off (under a per-component, per-OS name) to this component's
        # `coverage-{{ job.slug }}` gate job, which merges its OS cells and
        # enforces the scoped `fail_under` gate. The per-cell `coverage report`
        # here stays for fast feedback but does NOT gate (`--fail-under=0`): a
        # line covered on one OS yet version/OS-gated off on another only
        # balances in the per-component union. See ADR-028 (decomposes ADR-026).
        run: |
          uv run coverage combine
          uv run coverage report --show-missing --fail-under=0
          mv .coverage ".coverage.{{ job.slug }}.{% raw %}${{ matrix.os }}{% endraw %}"
      - name: Upload coverage data
        # `include-hidden-files` is required for upload-artifact to pick up the
        # dotfile `.coverage.*`. Downloaded and merged by `coverage-{{ job.slug }}`.
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: coverage-{{ job.slug }}-{% raw %}${{ matrix.os }}{% endraw %}
          path: .coverage.{{ job.slug }}.{% raw %}${{ matrix.os }}{% endraw %}
          include-hidden-files: true
{% endfor %}
{#- Per-component coverage gates (ADR-028, decomposes ADR-026's single union
    gate). Each gate merges its component's OS cells (preserving ADR-026's
    cross-OS union WITHIN a component) and enforces `fail_under=99` scoped to
    that subtree, so a skipped (unchanged) component needs no gate. `source_pkgs`
    measures both `src/<pkg>` and `tests`, so each scope spans src + tests.
    Component gates pass only `--include`, so the pyproject `[tool.coverage.report]
    omit` (`_version.py`, the worker integration file) still applies; the core
    gate passes `--omit` (which overrides config omit) so it re-adds `_version.py`
    and omits every component's src+tests subtree. Patterns are `*/`-anchored to
    match both the editable `src/` and installed `site-packages/` layouts. -#}
{% for job in test_jobs %}
  coverage-{{ job.slug }}:
    name: Coverage gate ({{ job.slug }})
    needs: [changes, test-{{ job.slug }}]
    if: >-
      {% raw %}${{ !cancelled() && github.event.pull_request.draft != true{% endraw %}{% if job.gated %} &&
      {% raw %}(needs.changes.outputs.{% endraw %}{{ job.slug }}{% raw %} == 'true' ||
      needs.changes.outputs.core == 'true'){% endraw %}{% endif %} {% raw %}}}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
      - name: Download {{ job.slug }} coverage data
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8
        with:
          pattern: coverage-{{ job.slug }}-*
          merge-multiple: true
      - name: Combine and gate the {{ job.slug }} subtree
        # `--locked --only-group test` pins the SAME coverage version that produced
        # the `.coverage.*` data files (no unpinned drift), without building the
        # project. `relative_files` (pyproject) lets cross-runner paths merge.
        run: |
          uv run --locked --only-group test coverage combine
          uv run --locked --only-group test coverage report --show-missing {% if job.slug == 'core' %}--omit="*/_version.py{% for c in comp_names %},*/{{github_repo_name}}/{{c}}/*,*/tests/{{c}}/*{% endfor %}"{% else %}--include="*/{{github_repo_name}}/{{job.slug}}/*,*/tests/{{job.slug}}/*"{% endif %} --fail-under=99
{% endfor %}
  coverage-report:
    name: Combine coverage and publish
    # Central non-gating publish (gating lives in the per-component jobs above).
    # Renders combined HTML/XML from whatever component gates ran and uploads to
    # Codecov + (optionally) smokeshow. `if: !cancelled()` so it runs even when a
    # component is path-skipped; downloads all present `coverage-*-*` artifacts.
    needs: [changes, coverage-core{% for c in comp_names %}, coverage-{{ c }}{% endfor %}]
    # `!cancelled()` still publishes when a component gate failed, but must ALSO
    # carry the draft guard: on a draft PR every dependency is *skipped* (not
    # cancelled), so without it this job would run with zero coverage artifacts
    # and `coverage combine` would fail with "No data to combine".
    if: {% raw %}${{ !cancelled() && github.event.pull_request.draft != true }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
    env:
      # The `secrets` context is unavailable in `if:`, so surface CODECOV_TOKEN as
      # a presence flag — never expose the value job-wide.
      CODECOV_TOKEN_SET: {% raw %}${{ secrets.CODECOV_TOKEN != '' }}{% endraw %}
      REPO_IS_PUBLIC: {% raw %}${{ !github.event.repository.private }}{% endraw %}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
      - name: Download all coverage data
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8
        with:
          pattern: coverage-*-*
          merge-multiple: true
      - name: Combine and render (non-gating)
        # `--fail-under=0`: gating is done per component above; this job only
        # publishes. On a path-filtered PR the skipped components never ran, but
        # `source_pkgs` still makes coverage discover their (unexecuted) files and
        # report them at ~0%, which would misrepresent the combined number in
        # Codecov/smokeshow. So omit every component that did NOT run this time
        # (derived from the `changes` outputs — `core` forces the full report).
        # The `changes` booleans are workflow-derived (trusted), passed via env.
        env:
          CHANGED_CORE: {% raw %}${{ needs.changes.outputs.core }}{% endraw %}
{%- for c in comp_names %}
          CHANGED_{{ c | upper }}: {% raw %}${{ needs.changes.outputs.{% endraw %}{{ c }}{% raw %} }}{% endraw %}
{%- endfor %}
        run: |
          uv run --locked --only-group test coverage combine
          # `--omit` on the CLI overrides the pyproject omit, so re-add the always
          # -omitted files, then append each component that was skipped this run.
          omit="*/_version.py{% if include_worker %},*/worker/test_integration.py{% endif %}"
{%- for c in comp_names %}
          if [ "$CHANGED_CORE" != "true" ] && [ "$CHANGED_{{ c | upper }}" != "true" ]; then
            omit="$omit,*/{{github_repo_name}}/{{c}}/*,*/tests/{{c}}/*"
          fi
{%- endfor %}
          uv run --locked --only-group test coverage report --show-missing --omit="$omit" --fail-under=0
          uv run --locked --only-group test coverage html --omit="$omit"
          uv run --locked --only-group test coverage xml --omit="$omit"
      - name: Upload combined HTML report
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: coverage-html
          path: htmlcov
      - name: Upload coverage to Codecov
        # Uploads when the token is set or the repo is public (tokenless); only a
        # private repo with no token falls through to the visible skip below.
        # Best-effort (`fail_ci_if_error` defaults to false).
        if: {% raw %}${{ env.CODECOV_TOKEN_SET == 'true' || env.REPO_IS_PUBLIC == 'true' }}{% endraw %}
        uses: codecov/codecov-action@fb8b3582c8e4def4969c97caa2f19720cb33a72f  # v7.0.0
        with:
          files: ./coverage.xml
          token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
      - name: Note skipped coverage upload
        if: {% raw %}${{ env.CODECOV_TOKEN_SET != 'true' && env.REPO_IS_PUBLIC != 'true' }}{% endraw %}
        run: echo "::notice::CODECOV_TOKEN secret is not set and this repo is private — skipping the Codecov upload. See docs/maintaining/setup.rst (Repository setup) to enable coverage reporting."
{%- if include_sonarcloud %}
      - name: Upload combined coverage.xml for SonarCloud
        # The authoritative cross-matrix coverage.xml, consumed by the `sonar` job.
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: coverage-xml
          path: ./coverage.xml
{%- endif %}
{%- if include_smokeshow %}
      - name: Publish coverage HTML (public repos)
        # smokeshow uploads htmlcov to an ephemeral public URL and prints it — no
        # account or secret required (an optional key only raises rate limits).
        # Public repos only: a private report must not be published. Best-effort
        # and ordered LAST — a tokenless rate-limit or outage must never fail the
        # `check` gate nor block the authoritative Codecov/coverage.xml uploads
        # above; smokeshow is a supplementary mirror, not load-bearing. See ADR-026.
        if: {% raw %}${{ env.REPO_IS_PUBLIC == 'true' }}{% endraw %}
        continue-on-error: true
        run: uv run --no-project --with smokeshow smokeshow upload htmlcov
{%- endif %}
{%- if include_launcher or include_freezer or include_compiler %}
  # Build-only PR guards: build each enabled standalone executable (ADR-007)
  # against the PR diff so a dependency or Python bump that breaks packaging fails
  # HERE, against the offending change, instead of silently at release time. The
  # test suite always runs the source tree, never the built binary, so these jobs
  # are the only thing that exercises packaging before a release. Each verifies the
  # binary was produced and uploads a 7-day preview artifact a reviewer can
  # launch-test. A CLI project is additionally smoke-run with `--help`; non-CLI
  # entrypoints (GUI/TUI/web/MCP/worker) block on a UI/server loop and so are only
  # existence-checked here, never runtime-verified — a reviewer must launch the
  # preview artifact to confirm those actually run. They closely follow the
  # release.yml build jobs (same setup + build commands) but skip the
  # release-only steps (the freezer's per-OS rename, and publishing).
{%- endif %}
{%- if include_launcher %}
  build-launcher-check:
    name: Build Launcher (PyCrucible) on {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-latest
            label: linux
          - os: windows-latest
            label: windows
          - os: macos-latest
            label: macos
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Build with PyCrucible
        uses: razorblade23/pycrucible-action@fcd0e906edafca9e4838f311eab47e03ef38115a  # v4
        with:
          source: '.'
          output: './dist/{{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}'
      - name: Verify the launcher was produced
        shell: bash
        run: |
          shopt -s nullglob
          files=(./dist/{{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}*)
          bin="${files[0]:-}"
          test -n "$bin" || { echo "::error::PyCrucible produced no launcher"; exit 1; }
          test -s "$bin" || { echo "::error::launcher is empty"; exit 1; }
          [ "$RUNNER_OS" = Windows ] || test -x "$bin" || { echo "::error::launcher is not executable"; exit 1; }
{%- if include_cli %}
      - name: Smoke-run the launcher (CLI --help)
        # First run bootstraps uv + downloads the interpreter, then runs the CLI.
        shell: bash
        run: |
          shopt -s nullglob
          files=(./dist/{{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}*)
          bin="${files[0]:-}"
          echo "Running $bin --help"
          "$bin" --help
{%- endif %}
      - name: Upload launcher preview
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: {{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}-preview
          path: './dist/{{github_repo_name}}-launcher-{% raw %}${{ matrix.label }}{% endraw %}*'
          retention-days: 7
{%- endif %}
{%- if include_freezer %}
  build-freezer-check:
    name: Build Freezer (PyInstaller) on {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-latest
            ext: ""
          - os: windows-latest
            ext: ".exe"
          - os: macos-latest
            ext: ""
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Build with PyInstaller
        run: uv run --locked --group tool pyinstaller {{github_repo_name}}.spec --clean --noconfirm
      - name: Verify the bundle was produced
        shell: bash
        run: |
          bin="./dist/{{github_repo_name}}{% raw %}${{ matrix.ext }}{% endraw %}"
          test -s "$bin" || { echo "::error::PyInstaller produced no executable"; exit 1; }
          [ "$RUNNER_OS" = Windows ] || test -x "$bin" || { echo "::error::executable is not runnable"; exit 1; }
{%- if include_cli %}
      - name: Smoke-run the bundle (CLI --help)
        shell: bash
        run: |
          echo "Running ./dist/{{github_repo_name}}{% raw %}${{ matrix.ext }}{% endraw %} --help"
          "./dist/{{github_repo_name}}{% raw %}${{ matrix.ext }}{% endraw %}" --help
{%- endif %}
      - name: Upload freezer preview
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: {{github_repo_name}}-freezer-{% raw %}${{ matrix.os }}{% endraw %}-preview
          path: './dist/{{github_repo_name}}{% raw %}${{ matrix.ext }}{% endraw %}'
          retention-days: 7
{%- endif %}
{%- if include_compiler %}
  build-compiler-check:
    name: Build Compiler (Nuitka) on {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-latest
            label: linux
          - os: windows-latest
            label: windows
          - os: macos-latest
            label: macos
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Build with Nuitka
        # GUI suppresses the Windows console window only (matrix-gated, Windows-only
        # flag); macOS needs no equivalent and --macos-create-app-bundle is avoided
        # because it emits a .app directory that breaks the single-file checks below.
        # See ADR-007 and the matching release.yml job.
        run: uv run --locked --group tool python -m nuitka --onefile --assume-yes-for-downloads --warn-implicit-exceptions --warn-unusual-code {% if include_gui %}{% raw %}${{ matrix.os == 'windows-latest' && '--windows-console-mode=disable' || '' }}{% endraw %} {% endif %}--output-filename={{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %} --output-dir=dist src/{{github_repo_name}}/__main__.py
      - name: Verify the binary was produced
        shell: bash
        run: |
          shopt -s nullglob
          files=(./dist/{{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %}*)
          bin="${files[0]:-}"
          test -n "$bin" || { echo "::error::Nuitka produced no binary"; exit 1; }
          test -s "$bin" || { echo "::error::binary is empty"; exit 1; }
          [ "$RUNNER_OS" = Windows ] || test -x "$bin" || { echo "::error::binary is not executable"; exit 1; }
{%- if include_cli %}
      - name: Smoke-run the binary (CLI --help)
        shell: bash
        run: |
          shopt -s nullglob
          files=(./dist/{{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %}*)
          bin="${files[0]:-}"
          echo "Running $bin --help"
          "$bin" --help
{%- endif %}
      - name: Upload compiler preview
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7
        with:
          name: {{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %}-preview
          path: './dist/{{github_repo_name}}-compiler-{% raw %}${{ matrix.label }}{% endraw %}*'
          retention-days: 7
{%- endif %}
{%- if include_worker %}
  worker-integration:
    name: Worker integration tests ({{worker_broker}})
    # Ubuntu-only: the real {{worker_broker}} runs in a Linux container — a
    # GitHub Actions service for redis/nats (below), an in-test testcontainer for
    # kafka/rabbitmq — and container support is Linux-runner-only. Runs only the
    # `integration`-marked tests (deselected from the default `test-*` jobs)
    # against a real {{worker_broker}} — the one thing that exercises the real
    # driver and serialization the in-memory unit tests stub out. See ADR-008.
    # Path-gated like the component test jobs (issue #160): skips the container
    # spin-up on PRs that touch neither the worker tree nor shared core.
    needs: changes
    if: >-
      {% raw %}${{ github.event.pull_request.draft != true &&
      (needs.changes.outputs.worker == 'true' ||
      needs.changes.outputs.core == 'true') }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
{%- set ci_service = worker_broker_spec.get("ci_service") %}
{%- if ci_service %}
    # {{worker_broker}} starts fast, so CI uses a GitHub Actions service
    # container — started (and torn down) by the runner before the job — instead
    # of an in-test testcontainer. Setting {{worker_broker_spec.env}} makes the
    # integration test connect to it directly and skip container startup; a
    # local `pytest -m integration` (no env var) still uses testcontainers.
    # Which brokers get this path, and every value below, is derived from
    # `worker_broker_spec.ci_service` — see ADR-008 / issue #169.
    services:
      {{ci_service.name}}:
        image: {{ci_service.image}}
        ports:
          - {{ci_service.port}}:{{ci_service.port}}
{%- if ci_service.health_cmd %}
        options: >-
          --health-cmd "{{ci_service.health_cmd}}"
          --health-interval 5s
          --health-timeout 3s
          --health-retries 5
{%- else %}
        # No `--health-cmd`: this image ships no usable in-container health probe,
        # so the runner cannot gate on readiness. It boots in well under a second
        # and the checkout/Python/uv setup steps precede the first test line, so
        # the service is long ready by then; the integration test's own
        # connect-retry covers the rest. See ADR-008.
{%- endif %}
    env:
      {{worker_broker_spec.env}}: {{ci_service.url}}
{%- endif %}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: Setup uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0
        with:
          enable-cache: true
          cache-dependency-glob: |
            pyproject.toml
            uv.lock
      - name: Run worker integration tests
        run: uv run --locked tox run -e integration
{%- endif %}
{%- if include_sonarcloud %}
  sonar:
    name: SonarCloud Scan
    needs: coverage-report
    # Opt-in and non-blocking, mirroring the Codecov upload: forks never receive
    # secrets and SonarCloud has no tokenless fallback, so skip fork PRs entirely;
    # on same-repo runs, the scan step is gated on the SONAR_TOKEN presence flag
    # (the `secrets` context is unavailable in `if:`) and records a visible skip
    # instead of failing when the secret is unset. Not wired into the `check`
    # aggregation gate — quality reporting is best-effort, not merge-blocking.
    if: {% raw %}${{ github.event.pull_request.head.repo.fork != true }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
    env:
      SONAR_TOKEN_SET: {% raw %}${{ secrets.SONAR_TOKEN != '' }}{% endraw %}
    steps:
      - name: Checkout repository
        # Full history so SonarCloud can attribute issues to blame/new-code.
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Download coverage.xml
        if: {% raw %}${{ env.SONAR_TOKEN_SET == 'true' }}{% endraw %}
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8
        with:
          name: coverage-xml
      - name: SonarCloud Scan
        if: {% raw %}${{ env.SONAR_TOKEN_SET == 'true' }}{% endraw %}
        uses: SonarSource/sonarqube-scan-action@22918119ff8e1ca75a623e15c8296b6ea4fbe28f  # v8.2.1
        env:
          SONAR_TOKEN: {% raw %}${{ secrets.SONAR_TOKEN }}{% endraw %}
          SONAR_HOST_URL: https://sonarcloud.io
      - name: Note skipped SonarCloud scan
        if: {% raw %}${{ env.SONAR_TOKEN_SET != 'true' }}{% endraw %}
        run: echo "::notice::SONAR_TOKEN secret is not set — skipping the SonarCloud scan. See docs/maintaining/setup.rst (Repository setup) to enable it."
{%- endif %}
  check:
    if: always()
    needs: [changes, test-core{% for c in comp_names %}, test-{{ c }}{% endfor %}, coverage-core{% for c in comp_names %}, coverage-{{ c }}{% endfor %}, coverage-report, hooks{% if include_launcher %}, build-launcher-check{% endif %}{% if include_freezer %}, build-freezer-check{% endif %}{% if include_compiler %}, build-compiler-check{% endif %}{% if include_worker %}, worker-integration{% endif %}]
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions: {}
    steps:
      - name: Decide whether the needed jobs succeeded or failed
        uses: re-actors/alls-green@05ac9388f0aebcb5727afa17fcccfecd6f8ec5fe  # release/v1
        with:
          jobs: {% raw %}${{ toJSON(needs) }}{% endraw %}
