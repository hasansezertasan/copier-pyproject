---
# Repository settings synced by the "Settings" GitHub App:
# https://github.com/apps/settings  (repo: repository-settings/app)
# Install the App on this repository, then edits to this file apply on push to
# the default branch.
#
# SECURITY: the App escalates anyone with push access to admin, because a merge
# to the default branch syncs whatever is in this file. See the "Optional
# integrations" note in docs/maintaining/setup.rst for the CODEOWNERS mitigation.
#
# NOTE: labels are intentionally NOT managed here. They are provisioned App-free
# by .github/labels.yml + .github/workflows/label-sync.yml. Do not add a
# `labels:` block — it would create a second, conflicting source of truth.
repository:
  description: "{{ short_description }}"
  # The generated project's docs site (GitHub Pages). Change if you host docs
  # elsewhere.
  homepage: "https://{{ github_user }}.github.io/{{ github_repo_name }}"
{%- set topic_list = repository_topics.split(",") | map("trim") | reject("equalto", "") | list %}
{%- if topic_list %}
  # Topics from the `repository_topics` answer, lower-cased with spaces and
  # underscores turned into hyphens. Omitted entirely when that answer is empty,
  # so the App leaves the repository's existing topics untouched. GitHub also
  # requires each topic to be letters/digits/hyphens only (<=50 chars) and allows
  # at most 20; the template does not enforce those, so keep the answer within
  # them or the App will reject the sync.
  topics:
{%- for topic in topic_list %}
    - "{{ topic | lower | replace(' ', '-') | replace('_', '-') }}"
{%- endfor %}
{%- endif %}
  # Encodes the squash-merge policy release-please REQUIRES (see the
  # "Repository setup" guide, docs/maintaining/setup.rst) as code, so it
  # survives a settings drift.
  allow_squash_merge: true
  allow_merge_commit: false
  allow_rebase_merge: false
  delete_branch_on_merge: true
  has_issues: true
