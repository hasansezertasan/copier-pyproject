---
# Repository settings synced by the "Settings" GitHub App:
# https://github.com/apps/settings  (repo: repository-settings/app)
# Install the App on this repository, then edits to this file apply on push to
# the default branch.
#
# SECURITY: the App escalates anyone with push access to admin, because a merge
# to the default branch syncs whatever is in this file. See the "Optional
# third-party integrations" note in CONTRIBUTING.md for the CODEOWNERS mitigation.
#
# NOTE: labels are intentionally NOT managed here. They are provisioned App-free
# by .github/labels.yml + .github/workflows/label-sync.yml. Do not add a
# `labels:` block — it would create a second, conflicting source of truth.
repository:
  description: "{{ short_description }}"
  # The generated project's docs site (GitHub Pages). Change if you host docs
  # elsewhere.
  homepage: "https://{{ github_user }}.github.io/{{ github_repo_name }}"
  # GitHub topics rules: lowercase letters/digits/hyphens, <=50 chars each, <=20
  # total. Trim or extend to taste — the App applies exactly this set. Any
  # `package_keywords` are lower-cased and space/underscore-hyphenated below;
  # remove any that are not valid topics.
  topics:
    - python
    - python-package
{%- for keyword in package_keywords.split(",") if keyword.strip() %}
    - "{{ keyword.strip() | lower | replace(' ', '-') | replace('_', '-') }}"
{%- endfor %}
{%- if include_cli %}
    - cli
{%- endif %}
{%- if include_web %}
    - {{ web_framework }}
{%- endif %}
{%- if include_tui %}
    - tui
{%- endif %}
{%- if include_gui %}
    - gui
{%- endif %}
{%- if include_mcp %}
    - mcp
{%- endif %}
{%- if include_worker %}
    - message-queue
{%- endif %}
{%- if include_c_extensions %}
    - cython
{%- endif %}
  # Encodes the squash-merge policy release-please REQUIRES (see CONTRIBUTING's
  # "Repository setup") as code, so it survives a settings drift.
  allow_squash_merge: true
  allow_merge_commit: false
  allow_rebase_merge: false
  delete_branch_on_merge: true
  has_issues: true
