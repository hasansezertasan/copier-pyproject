---
# yaml-language-server: $schema=https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json
$schema: https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json
version: "0.2"
# The generated Code of Conduct and Contributing guide use British spelling
# (behaviour, licence, apologising, …), so enable both US and GB dictionaries.
language: en,en-GB
dictionaries:
  - softwareTerms
  - companies
  - python
  - bash
  - filetypes
  - en_US
allowCompoundWords: true
words:
  # Tooling referenced in the generated docs
  - basedpyright
  - cobo
  - codespell
  - ghalint
  - megalinter
  - prek
  - unticked
  - zizmor
  - zuban
  - MYENVPREFIX
  # Project identifiers, so a project never trips on its own name/handle.
  # Quoted so a name that is a YAML boolean/null token (e.g. a repo literally
  # named "off" or "null") still renders as a string, which cspell requires.
  - "{{ github_user }}"
  - "{{ github_repo_name }}"
  # Author display-name tokens, derived from author_full_name so an author never
  # trips on their own name in the generated README/CITATION/CODE_OF_CONDUCT.
  # `tojson` emits a YAML-safe double-quoted scalar (escaping any `"`/`\` in the
  # free-form name, and keeping a YAML boolean/null token like "off" a string).
{%- for token in author_full_name.split() %}
  - {{ token | tojson }}
{%- endfor %}
