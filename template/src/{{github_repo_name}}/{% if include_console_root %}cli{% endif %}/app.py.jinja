# Every component's runtime dependency is a core ``dependency`` of this package
# (there are no per-component extras), so a missing one never means "install the
# extra" -- it means this environment is out of sync with the installed metadata.
# That happens after a ``copier update`` enables a component, or in a stale venv.
_MISSING_DEPENDENCY = "Error: The {component} component requires '{missing}', which is not available in this environment. {hint}"  # noqa: E501
_SYNC_HINT = f"Component dependencies ship with '{PROJECT_NAME}', so this usually means your environment is out of sync -- run `uv sync` (or reinstall the package) and try again."  # noqa: E501
{%- if include_gui %}
# ``tkinter`` is the one exception to the comment above: it is a standard-library
# extension module, not a distribution, so ``uv sync`` cannot install it. Missing
# means this interpreter was built without Tk -- a system-level fix. Homebrew's
# ``python-tk`` is an alias for the newest Python's formula, so the bare name
# would install Tk for the wrong interpreter; pin it to the running version.
_TK_HINT = f"'tkinter' is part of the Python standard library but ships as a separate system package on many platforms, so a dependency sync cannot install it -- install your platform's Tk bindings (Debian/Ubuntu: `sudo apt install python3-tk`; Fedora: `sudo dnf install python3-tkinter`; macOS/Homebrew: `brew install python-tk@{sys.version_info.major}.{sys.version_info.minor}`), or use a Python build that includes Tk."  # noqa: E501
{%- endif %}
{#- The allowlists come from ``component_dependencies`` in ``copier.yml``, the
    single source shared with ``__main__.py``'s sole-component guard -- see
    ADR-028. ``gui`` carries ``_tkinter`` beside ``tkinter`` because that C
    extension is the name that actually fails on an interpreter built without
