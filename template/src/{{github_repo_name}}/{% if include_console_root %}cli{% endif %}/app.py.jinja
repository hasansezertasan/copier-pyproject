"""CLI application for the project.

The ``{{github_repo_name}}`` command is the single Typer root. Every enabled
component other than the primary (CLI > GUI > TUI > web > MCP > worker) is hung
off it as a lazily-imported subcommand — ``{{github_repo_name}} interactive``
(TUI), ``{{github_repo_name}} web``, ``{{github_repo_name}} mcp``, ... — rather
than a separate ``{{github_repo_name}}-<name>`` console script (see ADR-019).
{%- if not include_cli %}
This project has no ``include_cli`` feature, so this module is a *minimal
launcher*: it carries no ``version``/``info`` commands. Bare
``{{github_repo_name}}`` launches the primary component (``{{primary_component}}``)
via the default callback.
{%- endif %}
"""
# mypy: disable-error-code="misc"

from __future__ import annotations

{% if include_cli -%}
import platform
from importlib.metadata import Distribution, PackageNotFoundError

{% endif -%}
import typer

{% if include_cli -%}
from {{github_repo_name}}.__metadata__ import PROJECT_NAME
{% endif -%}
from {{github_repo_name}}.core.logging_setup import get_logger

{% set cli_all = ["app"] -%}
{%- if include_cli %}{% set _ = cli_all.append("show_version") %}{% set _ = cli_all.append("info") %}{% else %}{% set _ = cli_all.append("default") %}{% endif -%}
{%- if include_tui and primary_component != 'tui' %}{% set _ = cli_all.append("interactive") %}{% endif -%}
{%- if include_gui and primary_component != 'gui' %}{% set _ = cli_all.append("gui") %}{% endif -%}
{%- if include_web and primary_component != 'web' %}{% set _ = cli_all.append("web") %}{% endif -%}
{%- if include_mcp and primary_component != 'mcp' %}{% set _ = cli_all.append("mcp") %}{% endif -%}
{%- if include_worker and primary_component != 'worker' %}{% set _ = cli_all.append("worker") %}{% endif -%}
{%- set _ = cli_all.sort() -%}
__all__ = [{% for n in cli_all %}"{{ n }}"{% if not loop.last %}, {% endif %}{% endfor %}]

logger = get_logger()

app = typer.Typer(name="{{github_repo_name}}"{% if include_cli %}, no_args_is_help=True{% endif %})
{%- if not include_cli %}


@app.callback(invoke_without_command=True)
def default(ctx: typer.Context) -> None:  # pragma: no cover
    """Launch the primary component (``{{primary_component}}``) by default.

    Runs when ``{{github_repo_name}}`` is invoked with no subcommand; a named
    subcommand always takes precedence.
{%- if primary_component in ["gui", "tui"] %}

    Raises:
        typer.Exit: Propagating the primary component's exit code.
{%- endif %}
    """
    if ctx.invoked_subcommand is not None:
        return
    from {{github_repo_name}}.{{primary_component}}.app import main  # noqa: PLC0415

    {{ "raise typer.Exit(code=main())" if primary_component in ["gui", "tui"] else "main()" }}
{%- endif %}
{%- if include_cli %}


@app.command(name="version")
def show_version() -> None:
    """Show the current version number of {{github_repo_name}}.

    Show the version number:
        {{github_repo_name}} version

    Example output:
        0.1.0

    Raises:
        typer.Exit: If the package metadata cannot be found.
    """
    try:
        distribution = Distribution.from_name(PROJECT_NAME)
    except PackageNotFoundError:
        logger.exception("Package metadata not found for %s", PROJECT_NAME)
        typer.echo(
            f"Error: Package '{PROJECT_NAME}' metadata not found. Is the package installed correctly?",  # noqa: E501
            err=True,
        )
        raise typer.Exit(code=1) from None
    logger.info("Command `version` called.")
    typer.echo(distribution.version)
    logger.info("Version displayed successfully.")


@app.command()
def info() -> None:
    """Display information about the {{github_repo_name}} application.

    Show application information:
        {{github_repo_name}} info

    Example output:
        Application Version: 0.1.0
        Python Version: 3.12.0 (CPython)
        Platform: Darwin

    Raises:
        typer.Exit: If the package metadata cannot be found.
    """
    try:
        distribution = Distribution.from_name(PROJECT_NAME)
    except PackageNotFoundError:
        logger.exception("Package metadata not found for %s", PROJECT_NAME)
        typer.echo(
            f"Error: Package '{PROJECT_NAME}' metadata not found. Is the package installed correctly?",  # noqa: E501
            err=True,
        )
        raise typer.Exit(code=1) from None
    logger.info("Command `info` called.")
    python_version = platform.python_version()
    python_implementation = platform.python_implementation()
    typer.echo(f"Application Version: {distribution.version}")
    typer.echo(f"Python Version: {python_version} ({python_implementation})")
    typer.echo(f"Platform: {platform.system()}")
    logger.info("Application information displayed successfully.")
{%- endif %}
{%- if include_tui and primary_component != 'tui' %}


@app.command()
def interactive() -> None:  # pragma: no cover
    """Start interactive mode (TUI) for {{github_repo_name}}.

    Launch the terminal user interface:
        {{github_repo_name}} interactive

    Raises:
        typer.Exit: Propagating the TUI's exit code.
    """
    from {{github_repo_name}}.tui.app import main  # noqa: PLC0415

    raise typer.Exit(code=main())
{%- endif %}
{%- if include_gui and primary_component != 'gui' %}


@app.command()
def gui() -> None:  # pragma: no cover
    """Start the graphical user interface for {{github_repo_name}}.

    Launch the GUI:
        {{github_repo_name}} gui

    Raises:
        typer.Exit: Propagating the GUI's exit code.
    """
    from {{github_repo_name}}.gui.app import main  # noqa: PLC0415

    raise typer.Exit(code=main())
{%- endif %}
{%- if include_web and primary_component != 'web' %}


@app.command()
def web() -> None:  # pragma: no cover
    """Start the web interface for {{github_repo_name}}.

    Launch the web server:
        {{github_repo_name}} web
    """
    from {{github_repo_name}}.web.app import main  # noqa: PLC0415

    main()
{%- endif %}
{%- if include_mcp and primary_component != 'mcp' %}


@app.command()
def mcp() -> None:  # pragma: no cover
    """Start the MCP server for {{github_repo_name}}.

    Launch the MCP server:
        {{github_repo_name}} mcp
    """
    from {{github_repo_name}}.mcp.app import main  # noqa: PLC0415

    main()
{%- endif %}
{%- if include_worker and primary_component != 'worker' %}


@app.command()
def worker() -> None:  # pragma: no cover
    """Start the message queue worker for {{github_repo_name}}.

    Launch the worker:
        {{github_repo_name}} worker
    """
    from {{github_repo_name}}.worker.app import main  # noqa: PLC0415

    main()
{%- endif %}
