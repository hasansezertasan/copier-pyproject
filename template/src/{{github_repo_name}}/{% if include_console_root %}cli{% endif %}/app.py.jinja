_APP_PATH_HELP = "Application to run as 'module:attribute'."
# ``TypeAlias``, not a bare assignment: ruff's parenthesize-tuple-in-subscript
# rule otherwise reads ``Annotated[X, Y]`` as an unparenthesized tuple.
_AppPath: TypeAlias = Annotated[str | None, typer.Argument(help=_APP_PATH_HELP)]
