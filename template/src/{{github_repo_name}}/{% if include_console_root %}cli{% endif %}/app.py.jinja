def build_parser() -> argparse.ArgumentParser:
    """Build the top-level argument parser for the {{github_repo_name}} CLI.

    Returns:
        The configured parser with the ``version``/``info`` commands and one
        subcommand per enabled non-primary component.
    """
    parser = argparse.ArgumentParser(prog="{{github_repo_name}}")
    subparsers = parser.add_subparsers(dest="command", metavar="COMMAND")
    _ = subparsers.add_parser("version", help="Show the version number.")
    _ = subparsers.add_parser("info", help="Show application and environment info.")
{%- if include_tui and primary_component != 'tui' %}
    _ = subparsers.add_parser("interactive", help="Start interactive (TUI) mode.")
{%- endif %}
{%- if include_gui and primary_component != 'gui' %}
    _ = subparsers.add_parser("gui", help="Start the graphical interface.")
{%- endif %}
{%- if include_web and primary_component != 'web' %}
    _ = subparsers.add_parser("web", help="Start the web interface.")
{%- endif %}
{%- if include_web %}
    for name, summary in (
        ("run", "Run the web application."),
        ("dev", "Run the web application with autoreload."),
    ):
        launcher = subparsers.add_parser(name, help=summary)
        _ = launcher.add_argument(
            "app_path", nargs="?", default=None, help=_APP_PATH_HELP
        )
{%- endif %}
{%- if include_mcp and primary_component != 'mcp' %}
    _ = subparsers.add_parser("mcp", help="Start the MCP server.")
{%- endif %}
{%- if include_worker and primary_component != 'worker' %}
    _ = subparsers.add_parser("worker", help="Start the message queue worker.")
{%- endif %}
    return parser


def app(argv: list[str] | None = None) -> None:
    """Run the {{github_repo_name}} CLI application.

    Args:
        argv: Optional argument vector; defaults to ``sys.argv[1:]`` when ``None``.
    """
    parser = build_parser()
    args = parser.parse_args(argv)
    # ``argparse.Namespace`` attributes are ``Any``; narrow the dispatch key.
    command = cast("str | None", args.command)
{%- if include_web %}
    if command in {"run", "dev"}:
        # ``run``/``dev`` take an optional target, so they are dispatched here
        # rather than through the zero-argument ``_COMMANDS`` table.
        _run_web(cast("str | None", args.app_path), dev_mode=command == "dev")
        return
{%- endif %}
    handler = _COMMANDS.get(command) if command is not None else None
    if handler is None:
        # Parity with Typer's ``no_args_is_help``: show help when no command is
        # given rather than exiting silently.
        parser.print_help()
        return
    handler()
