@app.callback(invoke_without_command=True)
def default(ctx: typer.Context) -> None:  # pragma: no cover
    """Launch the primary component (``{{primary_component}}``) by default.

    Runs when ``{{github_repo_name}}`` is invoked with no subcommand; a named
    subcommand always takes precedence.
{% if primary_component in ["gui", "tui"] %}
    Raises:
        typer.Exit: Propagating the primary component's exit code, or code 1 if a
            dependency of the component is missing from this environment.
{%- else %}
    A missing dependency is reported by ``_component_dependencies`` below.
{%- endif %}
    """
    if ctx.invoked_subcommand is not None:
        return
    with _component_dependencies("{{ component_label[primary_component] }}", *_{{primary_component | upper}}_DEPENDENCIES{% if primary_component == "gui" %}, hint=_TK_HINT{% endif %}):
{%- if primary_component in component_preflight %}
        # Imported eagerly so this guard can classify its absence -- the component
        # itself imports it too late, or behind a third-party import guard. See
        # ``_preflight``.
{%- for module in component_preflight[primary_component] %}
        _preflight("{{ module }}")
{%- endfor %}
{%- endif %}
        from {{github_repo_name}}.{{primary_component}}.app import main  # noqa: PLC0415

    {{ "raise typer.Exit(code=main())" if primary_component in ["gui", "tui"] else "main()" }}
{%- endif %}
