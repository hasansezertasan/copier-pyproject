app = FastAPI(title="{{github_repo_name}}")


@app.get(
    "/version",
    response_class=PlainTextResponse,
    responses={503: {"description": "Package metadata is unavailable."}},
)
def get_version() -> str:
    """Return the current version number of the project.

    Returns:
        str: The version number as a plain text string.

    Raises:
        HTTPException: If the package metadata is unavailable.
    """
    try:
        resolved = service.version()
    except service.MetadataUnavailableError:
        logger.exception("Package metadata not found for %s", PROJECT_NAME)
        raise HTTPException(
            status_code=503,
            detail=f"Package metadata for '{PROJECT_NAME}' is unavailable",
        ) from None
    logger.info("HTTP GET `/version` called.")
    logger.info("Version displayed successfully.")
    return resolved


