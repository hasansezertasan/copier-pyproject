def resolve_bind() -> tuple[str, int]:
    """Resolve the web server bind ``(host, port)`` from the environment.

    Host and port default to a local-only address and can be overridden with
    the ``{PROJECT}_HOST`` / ``{PROJECT}_PORT`` environment variables, where
    ``{PROJECT}`` is the uppercased project name with dashes normalized to
    underscores so it is a valid shell variable name.

    Returns:
        tuple[str, int]: The resolved ``(host, port)`` pair.

    Raises:
        SystemExit: If ``{PROJECT}_PORT`` is set to a non-integer value.
    """
    prefix = PROJECT_NAME.upper().replace("-", "_")
    host = os.environ.get(f"{prefix}_HOST", "127.0.0.1")
    raw_port = os.environ.get(f"{prefix}_PORT", "8000")
    try:
        port = int(raw_port)
    except ValueError as exc:
        msg = f"Invalid {prefix}_PORT={raw_port!r}; expected an integer."
        # Log before exiting so the cause reaches structured log sinks, not just
        # the SystemExit message printed to stderr by the interpreter.
        logger.exception(msg)
        raise SystemExit(msg) from exc
    return host, port


#: The ASGI application ``{{github_repo_name}} run`` / ``{{github_repo_name}} dev``
#: start when given no explicit target. Spelled as a uvicorn import string
#: rather than passed as an object because autoreload re-imports the app in a
#: child process, so only the string form can reload (see ADR-032).
DEFAULT_APP_PATH = "{{github_repo_name}}.web.app:app"

#: Development mode always binds loopback, whatever ``{PROJECT}_HOST`` says: a
#: reloading server runs unreviewed code on save, so it belongs on the
#: developer's own machine. Matches ``fastapi dev``.
DEV_HOST = "127.0.0.1"


def resolve_app_path(app_path: str | None = None) -> str:
    """Resolve the ASGI application to run into a uvicorn import string.

    Args:
        app_path: An explicit ``"module:attribute"`` import string, or ``None``
            to run this project's own web application.

    Returns:
        str: The import string to hand to uvicorn.

    Raises:
        SystemExit: If ``app_path`` is not a ``module:attribute`` pair.
    """
    if app_path is None:
        return DEFAULT_APP_PATH
    module_name, separator, attribute = app_path.partition(":")
    # ``":" in attribute`` rejects ``module:attr:extra``, which ``partition``
    # would otherwise accept with a non-empty module and attribute and hand to
    # uvicorn to fail in its own words.
    if not separator or not module_name or not attribute or ":" in attribute:
        msg = f"Invalid application path {app_path!r}; expected 'module:attribute'."
        # Log before exiting so the cause reaches structured log sinks, not just
        # the SystemExit message printed to stderr by the interpreter.
        logger.error(msg)
        raise SystemExit(msg)
    return app_path


def _run_server(  # pragma: no cover
    target: str, *, host: str, port: int, reload: bool
) -> None:
    """Execute the uvicorn server loop.

    The irreducible blocking call, separated from the target and bind
    resolution so both stay measured (ADR-035).
    """
    import uvicorn  # noqa: PLC0415

    uvicorn.run(target, host=host, port=port, reload=reload)


def run_server(
    app_path: str | None = None,
    *,
    dev_mode: bool = False,
    runner: _ServerRunner = _run_server,
) -> None:
    """Run the web application with uvicorn.

    Args:
        app_path: An explicit ``"module:attribute"`` import string, or ``None``
            to run this project's own web application.
        dev_mode: When ``True``, enable autoreload and bind loopback.
        runner: Callable that starts the server. Defaults to the real uvicorn
            loop; injected in tests to avoid blocking on it.
    """
    target = resolve_app_path(app_path)
    host, port = resolve_bind()
    runner(target, host=DEV_HOST if dev_mode else host, port=port, reload=dev_mode)


def main(*, runner: _ServerRunner = _run_server) -> None:
    """Entry point for the web application.

    Args:
        runner: Callable that starts the server. Defaults to the real uvicorn
            loop; injected in tests to avoid blocking on it.
    """
    run_server(runner=runner)


__all__ = [
    "DEFAULT_APP_PATH",
    "DEV_HOST",
    "app",
    "get_info",
    "get_version",
    "main",
    "resolve_app_path",
    "resolve_bind",
    "run_server",
]
