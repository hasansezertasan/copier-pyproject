"""Module entrypoint for the project.

This is the single runnable entrypoint used by ``python -m {{github_repo_name}}``
and by every standalone-executable build (PyCrucible launcher, PyInstaller
freezer, Nuitka compiler — see ADR-007). The build tools all target this file,
so the component-selection logic lives here and nowhere else.

When a ``{{github_repo_name}}`` console root exists (``include_console_root`` —
the CLI, or ≥2 components sharing a launcher; see ADR-019), ``main()`` runs it,
which dispatches to the primary component by default and to each secondary via a
subcommand. Otherwise the single enabled component with the highest precedence —
CLI > GUI > TUI > web > MCP > worker — is wired to ``main()`` directly at
template-generation time (via the Jinja conditionals below). To change the
default entrypoint, re-render with a different component enabled or edit the
import/``main`` binding here directly. With no runnable component enabled,
``main()`` exits non-zero with an explanatory message.
"""
{%- if include_console_root %}
{#- Third-party modules the console root imports at *module scope*, before the
    component-dependency guard inside ``cli/app.py`` can run:
      * ``typer`` -- the root itself, unless an explicit ``include_cli`` +
        ``argparse`` choice makes it standard-library only (mirror the condition
        cli/app.py.jinja branches on).
      * ``pydantic`` / ``pydantic_settings`` -- pulled in transitively by
        ``core.logging_setup`` -> ``core.config`` when ``include_pydantic_settings``.
    The guard below is emitted exactly when this list is non-empty. -#}
{%- set root_dependencies = [] %}
{%- if not (include_cli and cli_framework == "argparse") %}{% set _ = root_dependencies.append("typer") %}{% endif %}
{%- if include_pydantic_settings %}{% set _ = root_dependencies.append("pydantic") %}{% set _ = root_dependencies.append("pydantic_settings") %}{% endif %}
{%- if root_dependencies %}

import sys
from collections.abc import Callable

# Each of these ships as a core dependency of this package, so a missing one
# never means "install an extra" -- it means this environment is out of sync with
# the installed metadata. A ``copier update`` that adds the shared launcher (or
# enables settings) adds both the code and its dependency at once, so an
# environment that has not been re-synced would otherwise fail here with a bare
# ``ModuleNotFoundError`` before any launcher code executes.
_ROOT_DEPENDENCIES = ({{ root_dependencies | map('tojson') | join(', ') }}{% if root_dependencies | length == 1 %},{% endif %})
_MISSING_ROOT_DEPENDENCY = "Error: The {{github_repo_name}} command requires the '{missing}' package, which is not installed. It ships with '{{github_repo_name}}', so this usually means your environment is out of sync -- run `uv sync` (or reinstall the package) and try again."  # noqa: E501


def _load_console_root() -> Callable[[], None]:
    """Import the console root, reporting its own missing dependency actionably.

    Returns:
        Callable[[], None]: The console-root application. Both roots are
            zero-argument callables: the argparse ``app`` defaults its ``argv``,
            and ``typer.Typer.__call__`` takes ``*args``.

    Raises:
        ModuleNotFoundError: Propagating a missing module that is not exactly one
            of the root's own dependencies, so an unrelated import defect keeps
            its diagnostic context.
        SystemExit: With code 1 when one of them is missing from this environment.
    """
    try:
        from {{github_repo_name}}.cli import app  # noqa: PLC0415
    except ModuleNotFoundError as exc:
        missing = exc.name
        if missing is None or missing not in _ROOT_DEPENDENCIES:
            raise
        _ = sys.stderr.write(_MISSING_ROOT_DEPENDENCY.format(missing=missing) + "\n")
        raise SystemExit(1) from None
    return app


# The dispatchers below carry `# pragma: no cover`: invoking them launches the
# blocking component (CLI loop, GUI mainloop, server, ...), which cannot run
# under headless CI. tests/test_main.py pins the import wiring and callability.
def main() -> None:  # pragma: no cover
    """Run the {{github_repo_name}} console root (primary + component subcommands)."""
    _load_console_root()()
{%- else %}

from {{github_repo_name}}.cli import app


# The dispatchers below carry `# pragma: no cover`: invoking them launches the
# blocking component (CLI loop, GUI mainloop, server, ...), which cannot run
# under headless CI. tests/test_main.py pins the import wiring and callability.
def main() -> None:  # pragma: no cover
    """Run the {{github_repo_name}} console root (primary + component subcommands)."""
    app()
{%- endif %}
{%- elif include_gui %}

import sys

from {{github_repo_name}}.gui.app import main as _entry


def main() -> None:  # pragma: no cover
    """Launch the GUI application."""
    sys.exit(_entry())
{%- elif include_tui %}

import sys

from {{github_repo_name}}.tui.app import main as _entry


def main() -> None:  # pragma: no cover
    """Launch the TUI application."""
    sys.exit(_entry())
{%- elif include_web %}

from {{github_repo_name}}.web.app import main as _entry


def main() -> None:  # pragma: no cover
    """Run the web application."""
    _entry()
{%- elif include_mcp %}

from {{github_repo_name}}.mcp.app import main as _entry


def main() -> None:  # pragma: no cover
    """Run the MCP server."""
    _entry()
{%- elif include_worker %}

from {{github_repo_name}}.worker.app import main as _entry


def main() -> None:  # pragma: no cover
    """Run the message queue worker."""
    _entry()
{%- else %}

import sys


def main() -> None:
    """Fail loudly: no runnable application component is enabled.

    A standalone-executable build was produced for a project with no
    CLI/GUI/TUI/web/MCP/worker component, so there is nothing to run. Exit with
    a non-zero status and a message rather than a silent no-op, which would look
    like a broken binary to whoever launched it.
    """
    sys.exit("No runnable application component is enabled; nothing to run.")
{%- endif %}


__all__ = ["main"]


if __name__ == "__main__":
    main()
