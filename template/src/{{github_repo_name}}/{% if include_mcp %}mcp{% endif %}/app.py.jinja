"""MCP (Model Context Protocol) server for the project."""
# mypy: disable-error-code="untyped-decorator, no-untyped-call"

from __future__ import annotations

from typing import Any

from mcp.server import Server
from mcp.server.stdio import stdio_server
from mcp.types import TextContent, Tool

from {{github_repo_name}}.__metadata__ import PROJECT_NAME
from {{github_repo_name}}.core import app as service
from {{github_repo_name}}.core.logging_setup import get_logger

__all__ = ["call_tool", "list_tools", "main", "run_server", "server"]

logger = get_logger()

server = Server(name="{{github_repo_name}}")


@server.list_tools()
async def list_tools() -> list[Tool]:  # noqa: RUF029  (MCP requires an async handler)
    """List available MCP tools.

    Returns:
        list[Tool]: The tools this server exposes to MCP clients.
    """
    return [
        Tool(
            name="version",
            description="Get the current version of {{github_repo_name}}",
            inputSchema={"type": "object", "properties": {}, "required": []},
        ),
        Tool(
            name="info",
            description="Get runtime information about {{github_repo_name}}",
            inputSchema={"type": "object", "properties": {}, "required": []},
        ),
    ]


@server.call_tool()
async def call_tool(name: str, arguments: dict[str, Any]) -> list[TextContent]:  # noqa: ARG001, RUF029  # pylint: disable=unused-argument  # pyright: ignore[reportExplicitAny, reportUnusedParameter]
    """Handle MCP tool calls.

    Args:
        name: The name of the tool to invoke (``version`` or ``info``).
        arguments: The tool arguments (unused by the built-in tools).

    Returns:
        list[TextContent]: The tool result as MCP text content.

    Raises:
        ValueError: If an unknown tool name is requested.
    """
    try:
        payload = service.info()
    except service.MetadataUnavailableError:
        logger.exception(
            "Failed to retrieve package metadata for '%s'. Ensure the package is installed correctly.",  # noqa: E501
            PROJECT_NAME,
        )
        error_msg = (
            f"Error: Package '{PROJECT_NAME}' metadata not found. Is it installed?"
        )
        return [TextContent(type="text", text=error_msg)]

    if name == "version":
        logger.info("MCP tool `version` called.")
        return [TextContent(type="text", text=payload["application_version"])]

    if name == "info":
        logger.info("MCP tool `info` called.")
        info_text = (
            f"Application Version: {payload['application_version']}\n"
            f"Python Version: {payload['python_version']} ({payload['python_implementation']})\n"  # noqa: E501
            f"Platform: {payload['platform']}"
        )
        return [TextContent(type="text", text=info_text)]

    msg = f"Unknown tool: {name}"
    raise ValueError(msg)


async def run_server() -> None:  # pragma: no cover
    """Run the MCP server using stdio transport.

    Excluded from coverage: it blocks on the stdio transport until the client
    disconnects. The tool logic it serves (``call_tool``/``list_tools``) is
    unit-tested separately.
    """
    logger.info("Starting MCP server for {{github_repo_name}}")
    async with stdio_server() as (read_stream, write_stream):
        init_options = server.create_initialization_options()
        await server.run(read_stream, write_stream, init_options)


def main() -> None:  # pragma: no cover
    """Entry point for the MCP server. Excluded from coverage: blocks on stdio."""
    import asyncio  # noqa: PLC0415

    asyncio.run(run_server())
